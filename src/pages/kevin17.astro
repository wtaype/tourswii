  <!-- ⚡ LÓGICA DE CONTROL STAFF & PESTAÑAS -->
  <script is:inline>
    (function() {
      // 1. Selector de Moneda en Panel de Staff
      let monedaStaff = 'PEN';
      const btnsPen = document.querySelectorAll('.btn-cur-pen');
      const btnsUsd = document.querySelectorAll('.btn-cur-usd');

      function aplicarMonedaStaff(cur) {
        monedaStaff = cur;
        btnsPen.forEach(b => b.classList.toggle('active', cur === 'PEN'));
        btnsUsd.forEach(b => b.classList.toggle('active', cur === 'USD'));

        document.querySelectorAll('.precio_staff').forEach(el => {
          const pen = el.getAttribute('data-pen');
          const usd = el.getAttribute('data-usd');
          el.textContent = cur === 'PEN' ? `S/ ${pen}` : `$ ${usd} USD`;
        });

        const statIng = document.getElementById('stat_ingresos_hoy');
        if (statIng) {
          const pen = statIng.getAttribute('data-pen');
          const usd = statIng.getAttribute('data-usd');
          statIng.textContent = cur === 'PEN' ? `S/ ${pen}` : `$ ${usd} USD`;
        }
      }

      btnsPen.forEach(b => b.addEventListener('click', () => aplicarMonedaStaff('PEN')));
      btnsUsd.forEach(b => b.addEventListener('click', () => aplicarMonedaStaff('USD')));

      // 2. Conmutador de Tema Global
      const btnsTheme = document.querySelectorAll('.btn-toggle-theme-global');
      const iconsTheme = document.querySelectorAll('.icon-theme-target');

      function toggleTemaStaff() {
        const actual = document.documentElement.dataset.theme || 'futuro';
        const nuevo = actual === 'futuro' ? 'luz' : 'futuro';
        document.documentElement.dataset.theme = nuevo;
        localStorage.setItem('wiTema_kevin17', nuevo);
        iconsTheme.forEach(icon => {
          icon.className = nuevo === 'futuro' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
        });
      }

      btnsTheme.forEach(btn => btn.addEventListener('click', toggleTemaStaff));

      // 3. Control de Pestañas (Sidebar + Bottom Nav Móvil)
      const titulos = {
        tab_resumen: 'Resumen General & Ventas',
        tab_recepcion: 'Recepción & Check-in en Base Hawka',
        tab_salidas: 'Despacho de Salidas (Anthony & Michael)',
        tab_equipos: 'Inventario de Botas, Esquís & Tablas',
        tab_tarifas: 'Tarifario de las 4 Disciplinas'
      };

      function cambiarPestana(targetId) {
        document.querySelectorAll('.tab-content-panel').forEach(p => p.style.display = 'none');
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) targetPanel.style.display = 'block';

        document.querySelectorAll('.sidebar-btn').forEach(btn => {
          btn.classList.toggle('activo', btn.getAttribute('data-target') === targetId);
        });

        document.querySelectorAll('.mobile-bottom-btn').forEach(btn => {
          btn.classList.toggle('activo', btn.getAttribute('data-target') === targetId);
        });

        const txtHeader = document.getElementById('txt_header_tab_title');
        if (txtHeader && titulos[targetId]) txtHeader.textContent = titulos[targetId];

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      document.querySelectorAll('.sidebar-btn[data-target]').forEach(btn => {
        btn.addEventListener('click', () => {
          cambiarPestana(btn.getAttribute('data-target'));
          cerrarSidebarMobile();
        });
      });

      document.querySelectorAll('.mobile-bottom-btn[data-target]').forEach(btn => {
        btn.addEventListener('click', () => {
          cambiarPestana(btn.getAttribute('data-target'));
        });
      });

      // 4. Sidebar Offcanvas Móvil
      const sidebar = document.getElementById('admin_sidebar');
      const backdrop = document.getElementById('sidebar_backdrop');
      const btnOpenSidebar = document.getElementById('btn_toggle_sidebar_mobile');
      const btnCloseSidebar = document.getElementById('btn_close_sidebar_mobile');

      function abrirSidebarMobile() {
        sidebar?.classList.add('open');
        backdrop?.classList.add('active');
      }

      function cerrarSidebarMobile() {
        sidebar?.classList.remove('open');
        backdrop?.classList.remove('active');
      }

      btnOpenSidebar?.addEventListener('click', abrirSidebarMobile);
      btnCloseSidebar?.addEventListener('click', cerrarSidebarMobile);
      backdrop?.addEventListener('click', cerrarSidebarMobile);
    })();
  </script>
