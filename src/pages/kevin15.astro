        document.getElementById('btn_lang_en')?.classList.toggle('active', lang === 'EN');

        const d = i18n[lang];
        if (!d) return;

        const elTop = document.getElementById('txt_topbar_cert'); if (elTop) elTop.textContent = d.topbar;
        const elSub = document.getElementById('txt_logo_sub'); if (elSub) elSub.textContent = d.sublogo;
        const elIng = document.getElementById('btn_txt_ingresar'); if (elIng) elIng.innerHTML = d.btn_ingresar;
        const elRes = document.getElementById('btn_txt_reservar'); if (elRes) elRes.innerHTML = d.btn_reservar;
        const elHBadge = document.getElementById('txt_hero_badge'); if (elHBadge) elHBadge.textContent = d.hero_badge;
        const elHTitle = document.getElementById('txt_hero_title'); if (elHTitle) elHTitle.innerHTML = d.hero_title;
        const elHDesc = document.getElementById('txt_hero_desc'); if (elHDesc) elHDesc.textContent = d.hero_desc;
        const elHRes = document.getElementById('txt_btn_hero_res'); if (elHRes) elHRes.textContent = d.hero_res;
        const elHExp = document.getElementById('txt_btn_hero_exp'); if (elHExp) elHExp.textContent = d.hero_exp;
        const elMTallas = document.getElementById('txt_metrica_tallas'); if (elMTallas) elMTallas.textContent = d.metrica_tallas;
        const elMEquipo = document.getElementById('txt_metrica_equipo'); if (elMEquipo) elMEquipo.textContent = d.metrica_equipo;
        const elMSunset = document.getElementById('txt_metrica_sunset'); if (elMSunset) elMSunset.textContent = d.metrica_sunset;
        const elMLockers = document.getElementById('txt_metrica_lockers'); if (elMLockers) elMLockers.textContent = d.metrica_lockers;
        const elCTitle = document.getElementById('txt_calc_title'); if (elCTitle) elCTitle.innerHTML = d.calc_title;
        const elCStatus = document.getElementById('txt_calc_status'); if (elCStatus) elCStatus.innerHTML = d.calc_status;
        const elLDis = document.getElementById('txt_label_disciplina'); if (elLDis) elLDis.textContent = d.label_disciplina;
        const elLPax = document.getElementById('txt_label_pax'); if (elLPax) elLPax.textContent = d.label_pax;
        const elLHor = document.getElementById('txt_label_horario'); if (elLHor) elLHor.textContent = d.label_horario;
        const elLTot = document.getElementById('txt_label_total'); if (elLTot) elLTot.textContent = d.label_total;
        const elLSec = document.getElementById('txt_label_pago_seguro'); if (elLSec) elLSec.innerHTML = d.label_pago_seguro;
        const elBCot = document.getElementById('txt_btn_whatsapp_cot'); if (elBCot) elBCot.textContent = d.btn_whatsapp_cot;

        document.querySelectorAll('.nav-link-i18n').forEach(el => {
          const key = el.getAttribute('data-key');
          if (d[key]) el.textContent = d[key];
        });
      }

      document.getElementById('btn_lang_es')?.addEventListener('click', () => aplicarIdioma('ES'));
      document.getElementById('btn_lang_en')?.addEventListener('click', () => aplicarIdioma('EN'));

      // 3. Conmutador de Tema
      const btnTheme = document.getElementById('btn_toggle_theme');
      const iconTheme = document.getElementById('icon_theme');

      function toggleTema() {
        const actual = document.documentElement.dataset.theme || 'futuro';
        const nuevo = actual === 'futuro' ? 'luz' : 'futuro';
        document.documentElement.dataset.theme = nuevo;
        localStorage.setItem('wiTema_kevin15', nuevo);
        if (iconTheme) iconTheme.className = nuevo === 'futuro' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
      }

      btnTheme?.addEventListener('click', toggleTema);

      // 4. Cotizador Dinámico
      const selectTour = document.getElementById('cot_tour');
      const inputPersonas = document.getElementById('cot_personas');
      const txtTotal = document.getElementById('cot_total_txt');
      const badgeDesc = document.getElementById('badge_descuento_grupo');
      const btnEnviar = document.getElementById('btn_enviar_cotizacion');

      function recalcularTotal() {
        const opt = selectTour.options[selectTour.selectedIndex];
        const precioUnitario = monedaActual === 'PEN' ? parseFloat(opt.value) : parseFloat(opt.getAttribute('data-usd'));
        const personas = parseInt(inputPersonas.value) || 1;

        let total = precioUnitario * personas;

        if (personas >= 5) {
          total = total * 0.90;
          if (badgeDesc) badgeDesc.style.display = 'block';
        } else {
          if (badgeDesc) badgeDesc.style.display = 'none';
        }

        const simbolo = monedaActual === 'PEN' ? 'S/' : '$';
        txtTotal.textContent = `${simbolo} ${total.toFixed(2)} ${monedaActual === 'USD' ? 'USD' : ''}`;
      }

      if (selectTour && inputPersonas) {
        selectTour.addEventListener('change', recalcularTotal);
        inputPersonas.addEventListener('input', recalcularTotal);
        recalcularTotal();
      }

      if (btnEnviar) {
        btnEnviar.addEventListener('click', function() {
          const selectedOption = selectTour.options[selectTour.selectedIndex];
          const nombreTour = idiomaActual === 'ES' ? selectedOption.getAttribute('data-es') : selectedOption.getAttribute('data-en');
          const personas = inputPersonas.value;
          const horario = document.getElementById('cot_horario').value;
          const total = txtTotal.textContent;

          const msg = `¡Hola Kevin Tours! Deseo reservar una experiencia de SandSki/Sandboard:%0A%0A` +
            `📍 *Disciplina:* ${encodeURIComponent(nombreTour)}%0A` +
            `👥 *Pasajeros:* ${personas}%0A` +
            `⏰ *Horario:* ${encodeURIComponent(horario)}%0A` +
            `💰 *Total Estimado:* ${encodeURIComponent(total)}%0A` +
            `📍 *Base de Encuentro:* Recepción Hospedaje Hawka%0A%0A` +
            `¿Tienen disponibilidad de instructores y botas para hoy?`;

          window.open(`https://wa.me/51985496463?text=${msg}`, '_blank');
        });
      }

      // 5. Mobile Drawer Toggle & Cierre con Backdrop
      const drawer = document.getElementById('mobile_drawer');
      const backdrop = document.getElementById('drawer_backdrop');
      const btnOpen = document.getElementById('btn_open_drawer');
      const btnClose = document.getElementById('btn_close_drawer');

      function abrirDrawer() {
        drawer?.classList.add('open');
        backdrop?.classList.add('active');
      }

      function cerrarDrawer() {
        drawer?.classList.remove('open');
        backdrop?.classList.remove('active');
      }

      btnOpen?.addEventListener('click', abrirDrawer);
      btnClose?.addEventListener('click', cerrarDrawer);
      backdrop?.addEventListener('click', cerrarDrawer);

      document.querySelectorAll('.drawer-item').forEach(link => {
        link.addEventListener('click', cerrarDrawer);
      });
    })();
  </script>
</body>
</html>
