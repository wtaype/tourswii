        tab_resumen: 'Resumen General de Operaciones & Ventas',
        tab_recepcion: 'Panel de Recepción & Check-in en Vivo',
        tab_salidas: 'Control y Despacho de Salidas en Dunas',
        tab_flota: 'Mantenimiento de Flota & Choferes MTC',
        tab_tarifas: 'Tarifario Oficial & Precios 2026',
        tab_blog: 'Publicación de Blog & Consejos'
      };

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab');
          tabBtns.forEach(b => {
            b.classList.toggle('activo', b.getAttribute('data-tab') === target);
          });
          tabPanels.forEach(p => p.style.display = 'none');

          const activePanel = document.getElementById(target);
          if (activePanel) activePanel.style.display = 'block';
          if (lblSeccion && titulos[target]) lblSeccion.textContent = titulos[target];

          // Cerrar sidebar en móvil al seleccionar
          cerrarSidebarAdmin();
        });
      });

      // 2. Conmutador de Moneda PEN / USD
      let monedaActual = 'PEN';
      const btnsPen = document.querySelectorAll('.btn-curr-pen');
      const btnsUsd = document.querySelectorAll('.btn-curr-usd');

      function setMoneda(cur) {
        monedaActual = cur;
        btnsPen.forEach(b => b.classList.toggle('active', cur === 'PEN'));
        btnsUsd.forEach(b => b.classList.toggle('active', cur === 'USD'));

        document.querySelectorAll('.precio_staff').forEach(el => {
          const pen = el.getAttribute('data-pen');
          const usd = el.getAttribute('data-usd');
          el.textContent = cur === 'PEN' ? `S/ ${pen}` : `$ ${usd} USD`;
        });

        const elStat = document.getElementById('stat_ingresos_hoy');
        if (elStat) {
          const p = elStat.getAttribute('data-pen');
          const u = elStat.getAttribute('data-usd');
          elStat.textContent = cur === 'PEN' ? `S/ ${p}` : `$ ${u} USD`;
        }
      }

      btnsPen.forEach(b => b.addEventListener('click', () => setMoneda('PEN')));
      btnsUsd.forEach(b => b.addEventListener('click', () => setMoneda('USD')));

      // 3. Conmutador de Tema
      const btnsTheme = document.querySelectorAll('.btn-toggle-theme');
      btnsTheme.forEach(btn => {
        btn.addEventListener('click', () => {
          const actual = document.documentElement.dataset.theme || 'futuro';
          const nuevo = actual === 'futuro' ? 'luz' : 'futuro';
          document.documentElement.dataset.theme = nuevo;
          localStorage.setItem('wiTema_kevin14', nuevo);
        });
      });

      // 4. Toggle Sidebar Móvil con Backdrop
      const btnMobileMenu = document.getElementById('btn_toggle_mobile_sidebar');
      const btnCloseSidebar = document.getElementById('btn_close_admin_sidebar');
      const sidebar = document.getElementById('sidebar_admin');
      const backdrop = document.getElementById('admin_backdrop');

      function abrirSidebarAdmin() {
        sidebar?.classList.add('open');
        backdrop?.classList.add('active');
      }

      function cerrarSidebarAdmin() {
        sidebar?.classList.remove('open');
        backdrop?.classList.remove('active');
      }

      btnMobileMenu?.addEventListener('click', abrirSidebarAdmin);
      btnCloseSidebar?.addEventListener('click', cerrarSidebarAdmin);
      backdrop?.addEventListener('click', cerrarSidebarAdmin);
    })();
  </script>
</body>
</html>
