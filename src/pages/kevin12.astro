  <!-- ⚡ LÓGICA DE INTERACTIVIDAD & TRADUCCIÓN -->
  <script is:inline>
    (function() {
      // 1. Selector de Moneda en Cotizador
      let monedaActual = 'PEN';
      let idiomaActual = 'ES';
      const btnPen = document.getElementById('calc_cur_pen');
      const btnUsd = document.getElementById('calc_cur_usd');

      function aplicarMoneda(cur) {
        monedaActual = cur;
        btnPen?.classList.toggle('active', cur === 'PEN');
        btnUsd?.classList.toggle('active', cur === 'USD');

        document.querySelectorAll('.precio_tour').forEach(el => {
          const pen = el.getAttribute('data-pen');
          const usd = el.getAttribute('data-usd');
          el.textContent = cur === 'PEN' ? `S/ ${pen}` : `$ ${usd} USD`;
        });
        recalcularTotal();
      }

      btnPen?.addEventListener('click', () => aplicarMoneda('PEN'));
      btnUsd?.addEventListener('click', () => aplicarMoneda('USD'));

      // 2. Diccionario ES / EN
      const i18n = {
        ES: {
          topbar: 'AGENCIA OFICIAL CERTIFICADA · MTC N° 11000',
          sublogo: 'Sandboard & Buggies Huacachina Oficial',
          nav_inicio: 'Inicio',
          nav_tours: 'Tours',
          nav_confianza: 'Por Qué Elegirnos',
          nav_blog: 'Blog & Tips',
          nav_plataformas: 'Confianza',
          nav_faq: 'FAQ',
          btn_ingresar: '<i class="fa-solid fa-arrow-right-to-bracket"></i> Ingresar',
          btn_reservar: '<i class="fa-brands fa-whatsapp"></i> Reservar',
          hero_badge: '#1 EN TRIPADVISOR · 2,400+ RESEÑAS 5★ EN HUACACHINA',
          hero_title: 'Adrenalina Extrema en el Oasis de <span class="text-gradient">Huacachina</span>',
          hero_desc: 'Tubulares areneros 4x4 de alta potencia con jaula reforzada, clases de sandboard guiadas por expertos y el atardecer más espectacular del desierto de Ica.',
          hero_res: 'Reservar Sunset (S/ 45 / $12)',
          hero_exp: 'Ver 8 Experiencias',
          metrica_sunset: 'Sunset Favorito',
          metrica_soat: 'SOAT Turístico',
          metrica_cancel: 'Cancela 24h',
          calc_title: '<i class="fa-solid fa-calculator" style="color: var(--neon-yellow);"></i> Cotizador en Vivo',
          calc_status: '<i class="fa-solid fa-circle-dot"></i> Salidas Disponibles Hoy',
          label_exp: '1. Experiencia en Dunas',
          label_pax: '2. Pasajeros',
          label_horario: '3. Horario',
          label_total: 'Total a Pagar:',
          label_pago_seguro: '<i class="fa-solid fa-lock"></i> Pago Seguro en Base',
          btn_whatsapp_cot: 'Confirmar Reserva por WhatsApp'
        },
        EN: {
          topbar: 'OFFICIAL CERTIFIED AGENCY · MTC N° 11000',
          sublogo: 'Official Sandboard & Buggies Huacachina',
          nav_inicio: 'Home',
          nav_tours: 'Tours',
          nav_confianza: 'Why Choose Us',
          nav_blog: 'Blog & Tips',
          nav_plataformas: 'Trust',
          nav_faq: 'FAQ',
          btn_ingresar: '<i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In',
          btn_reservar: '<i class="fa-brands fa-whatsapp"></i> Book Now',
          hero_badge: '#1 ON TRIPADVISOR · 2,400+ 5★ REVIEWS IN HUACACHINA',
          hero_title: 'Extreme Adrenaline in the Oasis of <span class="text-gradient">Huacachina</span>',
          hero_desc: 'High-power 4x4 dune buggies with reinforced cage, expert-guided sandboarding lessons, and the most spectacular sunset in the Ica desert.',
          hero_res: 'Book Sunset Tour (S/ 45 / $12)',
          hero_exp: 'Explore 8 Tours',
          metrica_sunset: 'Sunset Favorite',
          metrica_soat: 'Tourist Insurance',
          metrica_cancel: 'Free Cancel 24h',
          calc_title: '<i class="fa-solid fa-calculator" style="color: var(--neon-yellow);"></i> Live Calculator',
          calc_status: '<i class="fa-solid fa-circle-dot"></i> Departures Today',
          label_exp: '1. Dune Experience',
          label_pax: '2. Guests',
          label_horario: '3. Schedule',
          label_total: 'Total to Pay:',
          label_pago_seguro: '<i class="fa-solid fa-lock"></i> Secure Payment on Arrival',
          btn_whatsapp_cot: 'Confirm Booking via WhatsApp'
        }
      };

      function aplicarIdioma(lang) {
        idiomaActual = lang;
        document.getElementById('btn_lang_es')?.classList.toggle('active', lang === 'ES');
        document.getElementById('btn_lang_en')?.classList.toggle('active', lang === 'EN');

        const d = i18n[lang];
        if (!d) return;

        const elTop = document.getElementById('txt_topbar_cert'); if (elTop) elTop.textContent = d.topbar;
        const elSub = document.getElementById('txt_logo_sub'); if (elSub) elSub.textContent = d.sublogo;
        const elIng = document.getElementById('btn_txt_ingresar'); if (elIng) elIng.innerHTML = d.btn_ingresar;
        const elRes = document.getElementById('btn_txt_reservar'); if (elRes) elRes.innerHTML = d.btn_reservar;
        const elHBadge = document.getElementById('txt_hero_badge'); if (elHBadge) elHBadge.textContent = d.hero_badge;
        const elHTitle = document.getElementById('txt_hero_title'); if (elHTitle) elHTitle.innerHTML = d.hero_title;
        const elHDesc = document.getElementById('txt_hero_desc'); if (elHDesc) elHDesc.textContent = d.hero_desc;
        const elHRes = document.getElementById('txt_btn_hero_res'); if (elHRes) elHRes.textContent = d.hero_res;
        const elHExp = document.getElementById('txt_btn_hero_exp'); if (elHExp) elHExp.textContent = d.hero_exp;
        const elMSun = document.getElementById('txt_metrica_sunset'); if (elMSun) elMSun.textContent = d.metrica_sunset;
        const elMSoat = document.getElementById('txt_metrica_soat'); if (elMSoat) elMSoat.textContent = d.metrica_soat;
        const elMCancel = document.getElementById('txt_metrica_cancel'); if (elMCancel) elMCancel.textContent = d.metrica_cancel;
        const elCTitle = document.getElementById('txt_calc_title'); if (elCTitle) elCTitle.innerHTML = d.calc_title;
        const elCStatus = document.getElementById('txt_calc_status'); if (elCStatus) elCStatus.innerHTML = d.calc_status;
        const elLExp = document.getElementById('txt_label_exp'); if (elLExp) elLExp.textContent = d.label_exp;
        const elLPax = document.getElementById('txt_label_pax'); if (elLPax) elLPax.textContent = d.label_pax;
        const elLHor = document.getElementById('txt_label_horario'); if (elLHor) elLHor.textContent = d.label_horario;
        const elLTot = document.getElementById('txt_label_total'); if (elLTot) elLTot.textContent = d.label_total;
        const elLSec = document.getElementById('txt_label_pago_seguro'); if (elLSec) elLSec.innerHTML = d.label_pago_seguro;
        const elBCot = document.getElementById('txt_btn_whatsapp_cot'); if (elBCot) elBCot.textContent = d.btn_whatsapp_cot;

        document.querySelectorAll('.nav-link-i18n').forEach(el => {
          const key = el.getAttribute('data-key');
          if (d[key]) el.textContent = d[key];
        });
      }

      document.getElementById('btn_lang_es')?.addEventListener('click', () => aplicarIdioma('ES'));
      document.getElementById('btn_lang_en')?.addEventListener('click', () => aplicarIdioma('EN'));

      // 3. Conmutador de Tema
      const btnTheme = document.getElementById('btn_toggle_theme');
      const iconTheme = document.getElementById('icon_theme');

      function toggleTema() {
        const actual = document.documentElement.dataset.theme || 'futuro';
        const nuevo = actual === 'futuro' ? 'luz' : 'futuro';
        document.documentElement.dataset.theme = nuevo;
        localStorage.setItem('wiTema_kevin12', nuevo);
        if (iconTheme) iconTheme.className = nuevo === 'futuro' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
      }

      btnTheme?.addEventListener('click', toggleTema);

      // 4. Cotizador Dinámico
      const selectTour = document.getElementById('cot_tour');
      const inputPersonas = document.getElementById('cot_personas');
      const txtTotal = document.getElementById('cot_total_txt');
      const badgeDesc = document.getElementById('badge_descuento_grupo');
      const btnEnviar = document.getElementById('btn_enviar_cotizacion');

      function recalcularTotal() {
        const opt = selectTour.options[selectTour.selectedIndex];
        const precioUnitario = monedaActual === 'PEN' ? parseFloat(opt.value) : parseFloat(opt.getAttribute('data-usd'));
        const personas = parseInt(inputPersonas.value) || 1;
        const esPrivado = parseFloat(opt.value) === 250;

        let total = esPrivado ? precioUnitario : precioUnitario * personas;

        if (personas >= 5 && !esPrivado) {
          total = total * 0.90;
          if (badgeDesc) badgeDesc.style.display = 'block';
        } else {
          if (badgeDesc) badgeDesc.style.display = 'none';
        }

        const simbolo = monedaActual === 'PEN' ? 'S/' : '$';
        txtTotal.textContent = `${simbolo} ${total.toFixed(2)} ${monedaActual === 'USD' ? 'USD' : ''}`;
      }

      if (selectTour && inputPersonas) {
        selectTour.addEventListener('change', recalcularTotal);
        inputPersonas.addEventListener('input', recalcularTotal);
        recalcularTotal();
      }

      if (btnEnviar) {
        btnEnviar.addEventListener('click', function() {
          const selectedOption = selectTour.options[selectTour.selectedIndex];
          const nombreTour = idiomaActual === 'ES' ? selectedOption.getAttribute('data-es') : selectedOption.getAttribute('data-en');
          const personas = inputPersonas.value;
          const horario = document.getElementById('cot_horario').value;
          const total = txtTotal.textContent;

          const msg = `¡Hola Kevin Tours! Deseo reservar el siguiente tour:%0A%0A` +
            `📍 *Tour:* ${encodeURIComponent(nombreTour)}%0A` +
            `👥 *Pasajeros:* ${personas}%0A` +
            `⏰ *Horario:* ${encodeURIComponent(horario)}%0A` +
            `💰 *Total Estimado:* ${encodeURIComponent(total)}%0A` +
            `📍 *Punto:* Recepción Hospedaje Hawka%0A%0A` +
            `¿Podrían confirmarme la disponibilidad?`;

          window.open(`https://wa.me/51985496463?text=${msg}`, '_blank');
        });
      }

      // 5. Mostrar / Ocultar Tours Adicionales
      const btnToggleTours = document.getElementById('btn_toggle_mas_tours');
      const boxToursExtra = document.getElementById('tours_adicionales');
      const txtToggleTours = document.getElementById('txt_toggle_tours');
      const iconToggleTours = document.getElementById('icon_toggle_tours');

      btnToggleTours?.addEventListener('click', () => {
        const estaOculto = boxToursExtra.style.display === 'none';
        boxToursExtra.style.display = estaOculto ? 'grid' : 'none';
        txtToggleTours.textContent = estaOculto ? 'Ocultar Tours Adicionales' : 'Mostrar Más Tours & Paquetes (4 Adicionales)';
        iconToggleTours.className = estaOculto ? 'fa-solid fa-minus' : 'fa-solid fa-plus';
      });

      // 6. Mobile Drawer Toggle & Cierre al hacer click afuera (Backdrop)
      const drawer = document.getElementById('mobile_drawer');
      const backdrop = document.getElementById('drawer_backdrop');
      const btnOpen = document.getElementById('btn_open_drawer');
      const btnClose = document.getElementById('btn_close_drawer');

      function abrirDrawer() {
        drawer?.classList.add('open');
        backdrop?.classList.add('active');
      }

      function cerrarDrawer() {
        drawer?.classList.remove('open');
        backdrop?.classList.remove('active');
      }

      btnOpen?.addEventListener('click', abrirDrawer);
      btnClose?.addEventListener('click', cerrarDrawer);
      backdrop?.addEventListener('click', cerrarDrawer);

      document.querySelectorAll('.drawer-item').forEach(link => {
        link.addEventListener('click', cerrarDrawer);
      });
    })();
  </script>
