---
// src/pages/kevin12.astro
// 🏜️ Kevin Tours Evolution - Master Público Definitivo (SIN AUTH)
// 2 Idiomas (ES/EN 100% dinámico), 2 Monedas (PEN/USD), 2 Temas (Luz/Futuro),
// Pilares en display flex y CENTRADOS, Dirección con ref: Recepción Hospedaje Hawka (https://maps.app.goo.gl/mrCqrpsKLKYeLV9ZA),
// 8 Tours con botón Ver Más, 3 Blogs, Plataformas de Confianza, FAQ con foto lateral.
// Mobile Responsive Ultra Pulido con Drawer con Backdrop (click fuera para cerrar), Header separado y Footer centrado.
// Abre en: http://localhost:4321/kevin12

const telefono = '+51 985 496 463';
const telefonoLimpio = '51985496463';
const direccionOficial = 'Av. Ángela Perotti S/n, Laguna de Huacachina, Ica 11000, Perú';
const referenciaOficial = 'Recepción Hospedaje Hawka';
const mapShareUrl = 'https://maps.app.goo.gl/mrCqrpsKLKYeLV9ZA';
---

<!DOCTYPE html>
<html lang="es" data-theme="futuro" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <title>Kevin Tours | Sandboard & Buggies Huacachina Evolution 2026</title>
  <meta name="description" content="Agencia Oficial de Turismo de Aventura en Huacachina, Ica. Tubulares 4x4, Clases de Sandboard Profesional, Cuatrimotos y Líneas de Nazca." />

  <!-- Fuentes Locales y FontAwesome -->
  <link rel="preload" href="/google/Poppins-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/google/Poppins-600.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/google/Poppins-700.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />

  <!-- Anti-FOUC Inmediato -->
  <script is:inline>
    (function() {
      try {
        const guardado = localStorage.getItem('wiTema_kevin12');
        const sistema = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'futuro' : 'luz';
        document.documentElement.dataset.theme = guardado || sistema || 'futuro';
      } catch (e) {}
    })();
  </script>

  <style is:global>
    :root[data-theme="futuro"] {
      --bg-body: #05080c;
      --bg-card: rgba(13, 19, 28, 0.92);
      --bg-card-hover: rgba(20, 29, 44, 0.98);
      --bg-subtle: rgba(255, 255, 255, 0.04);
      --border-card: rgba(255, 255, 255, 0.12);
      --border-accent: rgba(255, 230, 0, 0.6);
      --neon-yellow: #ffe600;
      --fire-orange: #ff4500;
      --glow-cyan: #00f0ff;
      --wa-green: #25d366;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --header-bg: rgba(5, 8, 12, 0.96);
      --topbar-bg: linear-gradient(90deg, #ffe600, #ff4500, #ffe600);
      --topbar-text: #000;
      --shadow-xl: 0 20px 40px rgba(0, 0, 0, 0.6);
      --input-bg: #090e17;
    }

    :root[data-theme="luz"] {
      --bg-body: #f4f7fb;
      --bg-card: rgba(255, 255, 255, 0.96);
      --bg-card-hover: rgba(255, 255, 255, 1);
      --bg-subtle: rgba(0, 0, 0, 0.04);
      --border-card: rgba(0, 0, 0, 0.08);
      --border-accent: rgba(234, 88, 12, 0.6);
      --neon-yellow: #d97706;
      --fire-orange: #ea580c;
      --glow-cyan: #0284c7;
      --wa-green: #16a34a;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --header-bg: rgba(255, 255, 255, 0.96);
      --topbar-bg: linear-gradient(90deg, #f59e0b, #ea580c, #f59e0b);
      --topbar-text: #fff;
      --shadow-xl: 0 15px 35px rgba(0, 0, 0, 0.08);
      --input-bg: #f8fafc;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Poppins', system-ui, sans-serif; }

    body {
      background-color: var(--bg-body);
      background-image: url('/wpuntos.svg'), radial-gradient(circle at 50% 0%, rgba(255, 69, 0, 0.08) 0%, transparent 60%);
      background-attachment: fixed;
      color: var(--text-main);
      overflow-x: hidden;
      line-height: 1.55;
      transition: background-color 0.3s, color 0.3s;
    }

    h1, h2, h3, h4, .font-heading { font-family: 'Outfit', 'Poppins', sans-serif; }
    a { text-decoration: none; color: inherit; }

    /* Ancho requerido 80vw en pantallas grandes */
    .container-wide {
      width: 100%;
      max-width: 80vw;
      margin: 0 auto;
      padding: 0 1.2rem;
    }

    .section-88vh {
      min-height: 88vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 7vh 0;
      position: relative;
    }

    .btn-speed {
      background: linear-gradient(135deg, #ffe600 0%, #ff4500 100%);
      color: #000;
      font-weight: 800;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 0.8rem;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-speed:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(255, 230, 0, 0.45);
      filter: brightness(1.06);
    }

    .btn-glass {
      background: var(--bg-subtle);
      border: 1px solid var(--border-card);
      color: var(--text-main);
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 0.8rem;
      backdrop-filter: blur(10px);
      transition: all 0.2s;
    }

    .btn-glass:hover {
      border-color: var(--neon-yellow);
      color: var(--neon-yellow);
      transform: translateY(-2px);
    }

    .glass-card {
      background: var(--bg-card);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-card);
      border-radius: 1.2rem;
      box-shadow: var(--shadow-xl);
      transition: all 0.3s ease;
      overflow: hidden;
    }

    .glass-card:hover {
      border-color: var(--border-accent);
      background: var(--bg-card-hover);
    }

    .text-gradient {
      background: linear-gradient(135deg, #ffe600 0%, #f59e0b 50%, #ff4500 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .pill-box {
      display: inline-flex;
      align-items: center;
      background: var(--bg-subtle);
      border: 1px solid var(--border-card);
      border-radius: 999px;
      padding: 0.2rem;
      gap: 0.2rem;
    }

    .pill-item {
      border: none;
      background: transparent;
      padding: 0.3rem 0.65rem;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }

    .pill-item.active { background: var(--neon-yellow); color: #000; }

    .wa-flotante {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 9999;
      background: #25d366;
      color: #fff;
      width: 3.6rem;
      height: 3.6rem;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.85rem;
      box-shadow: 0 8px 25px rgba(37, 211, 102, 0.5);
      transition: all 0.3s;
      animation: pulse-wa 2s infinite;
    }

    .wa-flotante:hover { transform: scale(1.1); box-shadow: 0 12px 35px rgba(37, 211, 102, 0.7); }

    @keyframes pulse-wa {
      0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7); }
      70% { box-shadow: 0 0 0 16px rgba(37, 211, 102, 0); }
      100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
    }

    /* 6 Pilares de Confianza en Display Flex con Contenidos 100% Centrados */
    .pilares-flex-container {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      justify-content: center;
    }

    .pilar-flex-item {
      flex: 1 1 calc(33.333% - 1.5rem);
      min-width: 280px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 2.2rem 1.8rem;
    }

    .pilar-icon-box {
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 1.2rem;
    }

    .platform-badge {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 1rem 1.5rem;
      border-radius: 1rem;
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      box-shadow: var(--shadow-xl);
      transition: transform 0.2s;
    }
    .platform-badge:hover { transform: translateY(-3px); }

    /* ==================== MEDIA QUERIES ULTRA PULIDAS ==================== */
    @media (max-width: 1024px) {
      .container-wide { max-width: 92vw; padding: 0 1rem; }
      .grid-hero { grid-template-columns: 1fr !important; gap: 3rem !important; }
      .grid-faq { grid-template-columns: 1fr !important; }
      .grid-ubicacion { grid-template-columns: 1fr !important; }
      .pilar-flex-item { flex: 1 1 calc(50% - 1.5rem); }
    }

    @media (max-width: 768px) {
      .nav-desktop { display: none !important; }
      .btn-hamburger { display: flex !important; }
      .container-wide { max-width: 100vw; padding: 0 1.2rem; }
      .section-88vh { min-height: auto; padding: 3.5vh 0 4.5vh 0; }
      
      /* Espaciado del Header Móvil (No apretado) */
      .header-mobile-bar {
        gap: 0.8rem !important;
      }
      .logo-mobile-clean span.logo-title {
        font-size: 0.98rem !important;
      }
      .logo-sub-mobile { display: none !important; }
      .header-reservar-mobile { display: none !important; }

      /* Reducción equilibrada y más espaciada del Hero en móvil */
      .hero-title-responsive {
        font-size: 1.6rem !important;
        line-height: 1.25 !important;
        margin-bottom: 1rem !important;
      }
      .hero-desc-responsive {
        font-size: 0.88rem !important;
        line-height: 1.6 !important;
        margin-bottom: 1.5rem !important;
      }
      .hero-badge-responsive {
        font-size: 0.68rem !important;
        padding: 0.35rem 0.75rem !important;
        margin-bottom: 1rem !important;
      }
      .hero-buttons-responsive {
        flex-direction: column !important;
        gap: 0.8rem !important;
        width: 100% !important;
        margin-bottom: 2rem !important;
      }
      .hero-buttons-responsive a {
        width: 100% !important;
        justify-content: center !important;
        padding: 0.9rem 1rem !important;
        font-size: 0.9rem !important;
      }

      /* Pilares en móvil */
      .pilar-flex-item { flex: 1 1 100%; }

      /* Topbar móvil ultra compacta */
      .topbar-mobile {
        font-size: 0.68rem !important;
        padding: 0.35rem 0.8rem !important;
        justify-content: center !important;
        text-align: center !important;
      }
      .topbar-hide-mobile { display: none !important; }

      /* Métricas móvil en 2x2 centrado */
      .metrics-grid {
        grid-template-columns: 1fr 1fr !important;
        gap: 1.2rem 0.8rem !important;
        text-align: center !important;
      }

      /* Footer móvil 100% Centrado y Elegante */
      .grid-footer {
        grid-template-columns: 1fr !important;
        gap: 2.2rem !important;
        text-align: center !important;
      }
      .footer-brand-center {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        text-align: center !important;
      }
      .footer-social-center {
        justify-content: center !important;
      }
      .footer-payments-center {
        justify-content: center !important;
      }
      .footer-bottom-center {
        flex-direction: column !important;
        text-align: center !important;
        gap: 1rem !important;
      }
    }

    /* Backdrop / Overlay para cerrar al hacer clic afuera del drawer */
    .drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
      z-index: 10000;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .drawer-backdrop.active {
      opacity: 1;
      visibility: visible;
    }

    /* Mobile Drawer */
    .mobile-drawer {
      position: fixed;
      top: 0;
      right: -100%;
      width: 82%;
      max-width: 320px;
      height: 100vh;
      background: var(--bg-card);
      border-left: 1px solid var(--border-card);
      z-index: 10001;
      padding: 1.8rem 1.4rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: -10px 0 35px rgba(0,0,0,0.6);
    }
    .mobile-drawer.open { right: 0; }
    .drawer-link {
      padding: 0.8rem 0;
      font-size: 0.95rem;
      font-weight: 700;
      border-bottom: 1px solid var(--border-card);
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }
  </style>
</head>
<body>

  <!-- 🏁 BARRA SUPERIOR DE CONFIANZA -->
  <div style="background: var(--topbar-bg); color: var(--topbar-text); padding: 0.4rem 1rem; font-size: 0.73rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em;">
    <div class="container-wide topbar-mobile" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; margin: 0 auto 0 0;" class="topbar-mobile">
        <i class="fa-solid fa-shield-halved"></i>
        <span id="txt_topbar_cert">AGENCIA OFICIAL CERTIFICADA · MTC N° 11000</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.8rem;" class="topbar-hide-mobile">
        <span><i class="fa-solid fa-location-dot"></i> {referenciaOficial}</span>
        <a href={`https://wa.me/${telefonoLimpio}`} target="_blank" style="background: #000; color: #fff; padding: 0.2rem 0.75rem; border-radius: 999px; font-size: 0.7rem; display: inline-flex; align-items: center; gap: 0.35rem;">
          <i class="fa-brands fa-whatsapp" style="color: var(--wa-green);"></i> {telefono}
        </a>
      </div>
    </div>
  </div>

  <!-- 🌟 CABECERA DESKTOP + MÓVIL (MÁS SEPARADA Y VISUALMENTE LIMPIA) -->
  <header style="position: sticky; top: 0; z-index: 100; background: var(--header-bg); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border-card); padding: 0.75rem 0;">
    <div class="container-wide header-mobile-bar" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
      <!-- Logo -->
      <a href="/kevin12" class="logo-mobile-clean" style="display: flex; align-items: center; gap: 0.6rem; min-width: 0;">
        <div style="width: 2.5rem; height: 2.5rem; min-width: 2.5rem; border-radius: 0.7rem; background: linear-gradient(135deg, #ffe600, #ff4500); display: flex; align-items: center; justify-content: center; color: #000; font-size: 1.15rem; box-shadow: 0 0 15px rgba(255, 230, 0, 0.4);">
          <i class="fa-solid fa-bolt"></i>
        </div>
        <div style="overflow: hidden;">
          <span class="font-heading logo-title" style="font-size: 1.05rem; font-weight: 900; line-height: 1; display: block; letter-spacing: -0.4px; white-space: nowrap;">
            KEVIN TOURS <span class="text-gradient">EVOLUTION</span>
          </span>
          <span class="logo-sub-mobile" style="font-size: 0.62rem; font-weight: 700; color: var(--fire-orange); text-transform: uppercase; letter-spacing: 0.06em; display: block;" id="txt_logo_sub">
            Sandboard & Buggies Huacachina Oficial
          </span>
        </div>
      </a>

      <!-- Menú Desktop -->
      <nav class="nav-desktop" style="display: flex; align-items: center; gap: 0.25rem; background: var(--bg-subtle); padding: 0.3rem 0.5rem; border-radius: 999px; border: 1px solid var(--border-card);">
        <a href="#inicio" class="nav-link-i18n" data-key="nav_inicio" style="padding: 0.35rem 0.75rem; border-radius: 999px; font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">Inicio</a>
        <a href="#tours" class="nav-link-i18n" data-key="nav_tours" style="padding: 0.35rem 0.75rem; border-radius: 999px; font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">Tours</a>
        <a href="#confianza" class="nav-link-i18n" data-key="nav_confianza" style="padding: 0.35rem 0.75rem; border-radius: 999px; font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">Por Qué Elegirnos</a>
        <a href="#blog" class="nav-link-i18n" data-key="nav_blog" style="padding: 0.35rem 0.75rem; border-radius: 999px; font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">Blog & Tips</a>
        <a href="#plataformas" class="nav-link-i18n" data-key="nav_plataformas" style="padding: 0.35rem 0.75rem; border-radius: 999px; font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">Confianza</a>
        <a href="#faq" class="nav-link-i18n" data-key="nav_faq" style="padding: 0.35rem 0.75rem; border-radius: 999px; font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">FAQ</a>
      </nav>

      <!-- Zona Derecha: Idioma + Tema + Ingresar / Reservar + Hamburguesa -->
      <div style="display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0;">
        <!-- Selector Idioma ES / EN -->
        <div class="pill-box">
          <button type="button" class="pill-item active" id="btn_lang_es" style="padding: 0.25rem 0.55rem; font-size: 0.7rem;">ES</button>
          <button type="button" class="pill-item" id="btn_lang_en" style="padding: 0.25rem 0.55rem; font-size: 0.7rem;">EN</button>
        </div>

        <!-- Tema -->
        <button type="button" class="btn-glass" id="btn_toggle_theme" style="width: 2.1rem; height: 2.1rem; border-radius: 50%; padding: 0;" title="Modo Claro / Oscuro">
          <i class="fa-solid fa-moon" id="icon_theme" style="font-size: 0.85rem;"></i>
        </button>

        <!-- Botón Ingresar (Desktop) -->
        <a href="/kevin13" class="btn-glass topbar-hide-mobile" style="padding: 0.45rem 0.8rem; font-size: 0.78rem; font-weight: 700; color: var(--glow-cyan); border-color: var(--glow-cyan);" id="btn_txt_ingresar">
          <i class="fa-solid fa-arrow-right-to-bracket"></i> Ingresar
        </a>

        <!-- Botón Reservar (Desktop) -->
        <a href={`https://wa.me/${telefonoLimpio}?text=Hola%20Kevin%20Tours!%20Deseo%20reservar%20mi%20tour`} target="_blank" class="btn-speed header-reservar-mobile" style="padding: 0.5rem 1rem; font-size: 0.8rem;" id="btn_txt_reservar">
          <i class="fa-brands fa-whatsapp"></i> Reservar
        </a>

        <!-- Botón Hamburguesa Móvil -->
        <button type="button" class="btn-glass btn-hamburger" id="btn_open_drawer" style="display: none; width: 2.2rem; height: 2.2rem; border-radius: 0.6rem; padding: 0;">
          <i class="fa-solid fa-bars" style="font-size: 1rem;"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== BACKDROP PARA CERRAR AL HACER CLIC AFUERA ==================== -->
  <div id="drawer_backdrop" class="drawer-backdrop"></div>

  <!-- ==================== MOBILE DRAWER / MENÚ LATERAL ==================== -->
  <div id="mobile_drawer" class="mobile-drawer">
    <div>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-card);">
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <div style="width: 2rem; height: 2rem; border-radius: 0.5rem; background: linear-gradient(135deg, #ffe600, #ff4500); display: flex; align-items: center; justify-content: center; color: #000; font-size: 0.9rem;">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <strong style="font-size: 1rem;">Menú Kevin Tours</strong>
        </div>
        <button type="button" id="btn_close_drawer" style="background: transparent; border: none; font-size: 1.6rem; color: var(--text-muted); cursor: pointer;">&times;</button>
      </div>

      <!-- Links del menú idénticos a los de la web -->
      <nav style="display: flex; flex-direction: column;">
        <a href="#inicio" class="drawer-link drawer-item"><i class="fa-solid fa-house" style="color: var(--neon-yellow); width: 1.2rem;"></i> Inicio</a>
        <a href="#tours" class="drawer-link drawer-item"><i class="fa-solid fa-truck-monster" style="color: var(--fire-orange); width: 1.2rem;"></i> Tours</a>
        <a href="#confianza" class="drawer-link drawer-item"><i class="fa-solid fa-shield-halved" style="color: var(--glow-cyan); width: 1.2rem;"></i> Por Qué Elegirnos</a>
        <a href="#blog" class="drawer-link drawer-item"><i class="fa-solid fa-newspaper" style="color: var(--wa-green); width: 1.2rem;"></i> Blog & Tips</a>
        <a href="#plataformas" class="drawer-link drawer-item"><i class="fa-solid fa-award" style="color: #00af87; width: 1.2rem;"></i> Confianza</a>
        <a href="#faq" class="drawer-link drawer-item"><i class="fa-solid fa-circle-question" style="color: #a855f7; width: 1.2rem;"></i> FAQ</a>
        <a href="#ubicacion" class="drawer-link drawer-item"><i class="fa-solid fa-location-dot" style="color: var(--fire-orange); width: 1.2rem;"></i> Ubicación Base</a>
      </nav>
    </div>

    <!-- Botones de Acción idénticos -->
    <div style="display: flex; flex-direction: column; gap: 0.7rem;">
      <a href="/kevin13" class="btn-glass" style="width: 100%; justify-content: center; color: var(--glow-cyan); font-size: 0.88rem; border-color: var(--glow-cyan);">
        <i class="fa-solid fa-arrow-right-to-bracket"></i> Ingresar
      </a>
