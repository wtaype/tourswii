---
// src/feature/cliente/componentes/AjustesTab.astro
// ⚙️ Pestaña de Ajustes y Preferencias (<45 líneas)
---

<div class="cliente-tab-panel" id="tab_ajustes" style="display: none;">
  <div style="background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 1.2rem; padding: 1.6rem; display: flex; flex-direction: column; gap: 1.2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div>
        <strong style="display: block; font-size: 0.88rem; color: var(--text-main);">Confirmaciones por WhatsApp</strong>
        <span style="font-size: 0.75rem; color: var(--text-muted);">Recibir recordatorio de salida 2 horas antes</span>
      </div>
      <input type="checkbox" checked style="accent-color: var(--neon-yellow); transform: scale(1.3); cursor: pointer;" />
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; border-top: 1px solid var(--border-card);">
      <div>
        <strong style="display: block; font-size: 0.88rem; color: var(--text-main);">Moneda Predeterminada</strong>
        <span style="font-size: 0.75rem; color: var(--text-muted);">Visualizar tarifas en Soles o Dólares</span>
      </div>
      <select style="background: var(--input-bg); border: 1px solid var(--border-card); color: var(--text-main); padding: 0.4rem 0.8rem; border-radius: 0.6rem; font-size: 0.82rem; font-weight: 600;">
        <option value="PEN">Soles (PEN S/)</option>
        <option value="USD">Dólares (USD $)</option>
      </select>
    </div>
  </div>
</div>
