---
// src/feature/cliente/componentes/PromoTab.astro
// 🏷️ Pestaña de Cupones y Beneficios VIP (<40 líneas)
import { CLIENTE_VIP } from '../data/cliente.data.js';

interface Props {
  cliente?: typeof CLIENTE_VIP;
}

const { cliente = CLIENTE_VIP } = Astro.props;
---

<div class="cliente-tab-panel" id="tab_cupon" style="display: none;">
  <div style="background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 1.2rem; padding: 2rem; text-align: center;">
    <span style="color: var(--neon-yellow); font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">CUPÓN VIP ACTIVO</span>
    <div style="margin: 1.2rem auto; display: inline-block; padding: 0.8rem 2rem; border: 2px dashed var(--neon-yellow); border-radius: 1rem; background: rgba(255, 230, 0, 0.08);">
      <strong style="font-size: 1.8rem; letter-spacing: 3px; color: var(--neon-yellow);">{cliente.cupon}</strong>
    </div>
    <p style="font-size: 0.88rem; color: var(--text-muted); max-width: 450px; margin: 0 auto 1.5rem auto;">
      Presenta este código en Recepción Hospedaje Hawka o menciónalo por WhatsApp para recibir <strong>{cliente.descuento}% de descuento directo</strong> en cualquiera de nuestras 4 disciplinas.
    </p>
    <div style="display: inline-flex; gap: 0.5rem; background: var(--bg-subtle); padding: 0.6rem 1.2rem; border-radius: 999px; border: 1px solid var(--border-card); font-size: 0.78rem;">
      <i class="fa-solid fa-lock-open" style="color: var(--wa-green);"></i> Validez: Todo el año 2026
    </div>
  </div>
</div>
