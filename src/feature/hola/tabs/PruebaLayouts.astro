---
// src/feature/hola/tabs/PruebaLayouts.astro
import { useTranslations } from '../../../core/idioma/idioma';
import holaEs from '../idioma/es.json';
import holaEn from '../idioma/en.json';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang, { es: holaEs, en: holaEn });
---

<div class="hola_tab_card">
  <div class="hola_tab_header">
    <div class="hola_tab_icon"><i class="fa-solid fa-layer-group"></i></div>
    <div>
      <h3>{t('layouts_test.titulo')}</h3>
      <p>{t('layouts_test.desc')}</p>
    </div>
  </div>

  <div class="hola_grid_tests">
    <!-- Layout Cliente -->
    <div class="hola_caja_test layout_demo">
      <div class="demo_icon"><i class="fa-solid fa-globe"></i></div>
      <h4>{t('layouts_test.modo_cliente')}</h4>
      <p>Navbar superior, Hero, Catálogo y Footer turístico con CSS inlined.</p>
      <span class="badge_layout activo">Vista Activa Actual</span>
    </div>

    <!-- Layout Personal -->
    <div class="hola_caja_test layout_demo">
      <div class="demo_icon"><i class="fa-solid fa-id-badge"></i></div>
      <h4>{t('layouts_test.modo_personal')}</h4>
      <p>Sidebar lateral de navegación, Tabs de módulos y cabecera de Staff.</p>
      <span class="badge_layout">Panel Staff</span>
    </div>
  </div>

  <div class="hola_acciones_test">
    <button class="hola_btn_accion" type="button" id="btn_toggle_layout_demo">
      <i class="fa-solid fa-arrows-rotate"></i> {t('layouts_test.btn_ver_personal')}
    </button>
  </div>
</div>
