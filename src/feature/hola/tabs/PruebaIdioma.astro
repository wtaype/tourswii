---
// src/feature/hola/tabs/PruebaIdioma.astro
import { useTranslations } from '../../../core/idioma/idioma';
import holaEs from '../idioma/es.json';
import holaEn from '../idioma/en.json';

interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang, { es: holaEs, en: holaEn });
---

<div class="hola_tab_card">
  <div class="hola_tab_header">
    <div class="hola_tab_icon"><i class="fa-solid fa-language"></i></div>
    <div>
      <h3>{t('idioma_test.titulo')}</h3>
      <p>{t('idioma_test.desc')}</p>
    </div>
  </div>

  <div class="hola_grid_tests">
    <!-- Idioma Activo -->
    <div class="hola_caja_test">
      <span class="hola_label">{t('idioma_test.idioma_actual')}</span>
      <div class="hola_badge_idioma">
        <span class="flag">{lang === 'en' ? '🇬🇧 English' : '🇪🇸 Español'}</span>
        <code>lang: "{lang}"</code>
      </div>
    </div>

    <!-- Ejemplo de Traducción en Vivo -->
    <div class="hola_caja_test">
      <span class="hola_label">{t('idioma_test.texto_prueba')}</span>
      <p class="hola_texto_traducido">"{t('subtitulo')}"</p>
    </div>
  </div>

  <!-- Botones de Conmutación de Idioma -->
  <div class="hola_acciones_test">
    <a href="/hola" class={`hola_btn_enlace ${lang === 'es' ? 'activo' : ''}`}>
      🇪🇸 {t('idioma_test.btn_ir_es')}
    </a>
    <a href="/en/hola" class={`hola_btn_enlace ${lang === 'en' ? 'activo' : ''}`}>
      🇬🇧 {t('idioma_test.btn_ir_en')}
    </a>
  </div>
</div>
