---
// src/feature/inicio/seccion/TrustPillars.astro
// 🛡️ 6 Pilares de Seguridad y Confianza (Consume idioma/es.json | en.json)
import esJson from '../idioma/es.json';
import enJson from '../idioma/en.json';

interface Props {
  idioma?: 'es' | 'en';
}

const { idioma = 'es' } = Astro.props;
const t = idioma === 'en' ? enJson.pilares_seccion : esJson.pilares_seccion;
const pilares = idioma === 'en' ? enJson.pilares : esJson.pilares;
---

<section id="confianza" class="section-pad section-bg-subtle">
  <div class="container-wide">
    
    <!-- Encabezado Centrado -->
    <div class="section-header-center">
      <span class="section-badge-center">
        {t.badge}
      </span>
      <h2 class="section-title-center">
        {t.titulo} <span class="text-gradient">{t.titulo_gradiente}</span>
      </h2>
      <p class="section-desc-center">
        {t.descripcion}
      </p>
    </div>

    <!-- Grid Simétrico 3 Columnas x 2 Filas -->
    <div class="grid-pilares-3x2">
      {pilares.map(p => (
        <div class="pilar-card glass-card">
          <div class="pilar-icon-wrapper" style={`background: ${p.bg}; color: ${p.color};`}>
            <i class={`fa-solid ${p.icono}`}></i>
          </div>
          <h3 class="pilar-title">
            {p.titulo}
          </h3>
          <p class="pilar-desc">
            {p.descripcion}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
