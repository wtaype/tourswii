---
// src/feature/inicio/seccion/Calculator.astro
// 🧮 Tarjeta Flotante del Cotizador Oficial en Vivo (Persistencia wiCotizacion & Animaciones Suaves)
import app from '../../../app.js';
import esJson from '../idioma/es.json';
import enJson from '../idioma/en.json';

interface Props {
  idioma?: 'es' | 'en';
}

const { idioma = 'es' } = Astro.props;
const t = idioma === 'en' ? enJson.cotizador : esJson.cotizador;
const disciplinas = idioma === 'en' ? enJson.disciplinas : esJson.disciplinas;
---

<div class="glass-card calculator-card">
  <div>
    <!-- Encabezado con Selector de Moneda -->
    <div class="calc-header">
      <div>
        <h3 class="calc-title">
          <i class="fa-solid fa-calculator" style="color: var(--neon-yellow);"></i>
          <span>{t.titulo}</span>
        </h3>
        <span class="calc-status">
          <i class="fa-solid fa-circle-dot"></i> {t.subtitulo}
        </span>
      </div>

      <!-- Selector S/ PEN vs $ USD -->
      <div class="pill-box calc-cur-box">
        <button type="button" class="pill-item active" id="calc_cur_pen">S/ PEN</button>
        <button type="button" class="pill-item" id="calc_cur_usd">$ USD</button>
      </div>
    </div>

    <!-- Formulario de Selección -->
    <form id="form_cotizador" class="calc-form">
      <div>
        <label class="calc-label">
          {t.label_disciplina}
        </label>
        <select id="cot_tour" class="calc-select">
          {disciplinas.map(d => (
            <option value={d.precio_pen} data-usd={d.precio_usd} data-nombre={d.nombre}>
              {d.nombre} (S/ {d.precio_pen} / ${d.precio_usd})
            </option>
          ))}
        </select>
      </div>

      <div class="calc-grid-2">
        <div>
          <label class="calc-label">
            {t.label_pax}
          </label>
          <input type="number" id="cot_personas" value="2" min="1" max="30" class="calc-input" />
        </div>
        <div>
          <label class="calc-label">
            {t.label_horario}
          </label>
          <select id="cot_horario" class="calc-select">
            {t.horarios.map(h => (
              <option value={h.valor}>{h.label}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Resumen Calculado con Micro-Animación -->
      <div class="calc-total-box">
        <div>
          <span class="calc-total-label">
            {t.total_label}
          </span>
          <strong id="cot_total_txt" class="calc-total-amount">S/ 170.00</strong>
        </div>
        <div style="text-align: right;">
          <span class="calc-total-safe">
            <i class="fa-solid fa-lock"></i> {t.punto_encuentro}
          </span>
          <span class="drawer-contact-info">{t.metodos_pago}</span>
        </div>
      </div>

      <!-- Botón WhatsApp -->
      <button type="button" id="btn_enviar_cotizacion" class="btn-speed calc-wa-submit">
        <i class="fa-brands fa-whatsapp"></i>
        <span>{t.btn_whatsapp}</span>
      </button>
    </form>
  </div>
</div>

<script>
  import app from '../../../app.js';

  let monedaActual = 'PEN';

  function guardarPersistencia(tourNombre: string, pax: string, horario: string, total: string) {
    try {
      localStorage.setItem('wiCotizacion', JSON.stringify({
        tourNombre,
        pax,
        horario,
        total,
        moneda: monedaActual,
        timestamp: Date.now()
      }));
    } catch (e) {}
  }

  function recuperarPersistencia() {
    try {
      const saved = localStorage.getItem('wiCotizacion');
      if (!saved) return;
      const data = JSON.parse(saved);
      if (data.moneda && (data.moneda === 'PEN' || data.moneda === 'USD')) {
        monedaActual = data.moneda;
        document.getElementById('calc_cur_pen')?.classList.toggle('active', monedaActual === 'PEN');
        document.getElementById('calc_cur_usd')?.classList.toggle('active', monedaActual === 'USD');
      }
      const inpPax = document.getElementById('cot_personas') as HTMLInputElement;
      if (inpPax && data.pax) inpPax.value = data.pax;
      const selHorario = document.getElementById('cot_horario') as HTMLSelectElement;
      if (selHorario && data.horario) selHorario.value = data.horario;
    } catch (e) {}
  }

  function recalcularTotal() {
    const selTour = document.getElementById('cot_tour') as HTMLSelectElement;
    const inpPax = document.getElementById('cot_personas') as HTMLInputElement;
    const selHorario = document.getElementById('cot_horario') as HTMLSelectElement;
    const txtTotal = document.getElementById('cot_total_txt');
    if (!selTour || !inpPax || !txtTotal) return;

    const opt = selTour.options[selTour.selectedIndex];
    const precio = monedaActual === 'USD' ? parseFloat(opt.dataset.usd || '23') : parseFloat(opt.value);
    const pax = Math.max(1, parseInt(inpPax.value, 10) || 1);
    const subtotal = precio * pax;
    const simbolo = monedaActual === 'USD' ? '$' : 'S/';
    const totalFormateado = `${simbolo} ${subtotal.toFixed(2)}`;

    txtTotal.textContent = totalFormateado;
    txtTotal.style.animation = 'none';
    // Trigger reflow
    void txtTotal.offsetHeight;
    txtTotal.style.animation = 'slideInSmooth 0.2s cubic-bezier(0.16, 1, 0.3, 1)';

    const tourNombre = opt.dataset.nombre || opt.text;
    guardarPersistencia(tourNombre, inpPax.value, selHorario?.value || '', totalFormateado);
  }

  function initCalculator() {
    recuperarPersistencia();

    document.getElementById('cot_tour')?.addEventListener('change', recalcularTotal);
    document.getElementById('cot_personas')?.addEventListener('input', recalcularTotal);
    document.getElementById('cot_horario')?.addEventListener('change', recalcularTotal);

    document.getElementById('calc_cur_pen')?.addEventListener('click', () => {
      monedaActual = 'PEN';
      document.getElementById('calc_cur_pen')?.classList.add('active');
      document.getElementById('calc_cur_usd')?.classList.remove('active');
      recalcularTotal();
    });

    document.getElementById('calc_cur_usd')?.addEventListener('click', () => {
      monedaActual = 'USD';
      document.getElementById('calc_cur_usd')?.classList.add('active');
      document.getElementById('calc_cur_pen')?.classList.remove('active');
      recalcularTotal();
    });

    document.getElementById('btn_enviar_cotizacion')?.addEventListener('click', () => {
      const selTour = document.getElementById('cot_tour') as HTMLSelectElement;
      const inpPax = document.getElementById('cot_personas') as HTMLInputElement;
      const selHorario = document.getElementById('cot_horario') as HTMLSelectElement;
      const txtTotal = document.getElementById('cot_total_txt');

      const tourNombre = selTour?.options[selTour.selectedIndex]?.dataset.nombre || selTour?.value;
      const pax = inpPax?.value || '2';
      const horario = selHorario?.value || '4:00 PM (Sunset)';
      const total = txtTotal?.textContent || 'S/ 170.00';

      const msg = `Hola Kevin Tours! 👋 Deseo confirmar mi reserva:
🎿 *Tour:* ${tourNombre}
👥 *Pasajeros:* ${pax}
⏰ *Horario:* ${horario}
💰 *Total Estimado:* ${total}
🏨 *Punto de Encuentro:* ${app.base.referencia} (${app.base.direccion})
¿Tienen disponibilidad para hoy?`;

      window.open(`https://wa.me/${app.telefonoLimpio}?text=${encodeURIComponent(msg)}`, '_blank');
    });

    recalcularTotal();
  }

  document.addEventListener('DOMContentLoaded', initCalculator);
  document.addEventListener('astro:page-load', initCalculator);
</script>
