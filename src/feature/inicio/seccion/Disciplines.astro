---
// src/feature/inicio/seccion/Disciplines.astro
// 🎿 4 Disciplinas Oficiales (Consume idioma/es.json | en.json)
import esJson from '../idioma/es.json';
import enJson from '../idioma/en.json';

interface Props {
  idioma?: 'es' | 'en';
}

const { idioma = 'es' } = Astro.props;
const t = idioma === 'en' ? enJson.disciplinas_seccion : esJson.disciplinas_seccion;
const disciplinas = idioma === 'en' ? enJson.disciplinas : esJson.disciplinas;
---

<section id="tours" class="section-pad">
  <div class="container-wide">
    
    <!-- Encabezado de Sección -->
    <div class="section-header-center">
      <span class="section-badge-center">
        {t.badge}
      </span>
      <h2 class="section-title-center">
        {t.titulo} <span class="text-gradient">{t.titulo_gradiente}</span>
      </h2>
      <p class="section-desc-center">
        {t.descripcion}
      </p>
    </div>

    <!-- Grid de las 4 Disciplinas -->
    <div class="grid-disciplinas">
      {disciplinas.map(d => (
        <div class="glass-card discipline-card">
          <div class="discipline-img-box">
            <img src={d.imagen} alt={d.nombre} class="discipline-img" loading="lazy" />
            <span class="discipline-tag-badge">{d.badge}</span>
            <span class="discipline-price-badge">
              S/ {d.precio_pen} <small style="font-size: 0.65rem; color: var(--text-muted);">/ ${d.precio_usd}</small>
            </span>
          </div>

          <div class="discipline-content">
            <h3 class="font-heading" style="font-size: 1.15rem; font-weight: 800; margin-bottom: 0.5rem;">
              {d.nombre}
            </h3>
            <p style="font-size: 0.82rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1rem;">
              {d.descripcion}
            </p>

            <ul style="list-style: none; font-size: 0.78rem; color: var(--text-main); display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1.2rem;">
              {d.beneficios.map(inc => (
                <li style="display: flex; align-items: center; gap: 0.4rem;">
                  <i class="fa-solid fa-circle-check" style="color: var(--wa-green);"></i>
                  <span>{inc}</span>
                </li>
              ))}
            </ul>

            <a href="#calculadora" class="btn-speed" style="width: 100%; padding: 0.65rem; font-size: 0.8rem;">
              <i class="fa-solid fa-calculator"></i>
              <span>{t.btn_cotizar}</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
