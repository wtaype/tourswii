---
// src/feature/inicio/seccion/Reputation.astro
// ⭐ Sellos Oficiales de Reputación y Reseñas (Consume idioma/es.json | en.json)
import esJson from '../idioma/es.json';
import enJson from '../idioma/en.json';

interface Props {
  idioma?: 'es' | 'en';
}

const { idioma = 'es' } = Astro.props;
const reputacion = idioma === 'en' ? enJson.reputacion : esJson.reputacion;
---

<section class="section-pad reputation-section">
  <div class="container-wide">
    <div class="grid-reputacion">
      {reputacion.map(rep => (
        <div class="reputation-card glass-card">
          <div class="reputation-icon-box" style={`color: ${rep.color};`}>
            <i class={`fa-solid ${rep.icono}`}></i>
          </div>
          <div class="reputation-info">
            <strong class="reputation-title">{rep.plataforma}</strong>
            <span class="reputation-score" style={`color: ${rep.color};`}>
              <i class="fa-solid fa-star"></i> {rep.score}
            </span>
            <span class="reputation-badge-text">{rep.insignia}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
