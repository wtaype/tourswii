---
// src/feature/inicio/seccion/LocationMap.astro
// 📍 Punto de Encuentro Oficial en Google Maps (Consume idioma/es.json | en.json)
import app from '../../../app.js';
import esJson from '../idioma/es.json';
import enJson from '../idioma/en.json';
import coreEs from '../../../core/idioma/es.json';
import coreEn from '../../../core/idioma/en.json';

interface Props {
  idioma?: 'es' | 'en';
}

const { idioma = 'es' } = Astro.props;
const t = idioma === 'en' ? enJson.ubicacion_seccion : esJson.ubicacion_seccion;
const negocioT = idioma === 'en' ? coreEn.negocio : coreEs.negocio;
---

<section id="ubicacion" class="section-pad">
  <div class="container-wide">
    <div class="grid-ubicacion">
      
      <!-- Datos de la Base Física -->
      <div class="glass-card" style="padding: 2rem;">
        <span class="section-badge-center" style="display: block; margin-bottom: 0.4rem;">
          {t.badge}
        </span>
        <h3 class="font-heading" style="font-size: 1.5rem; font-weight: 900; margin-bottom: 1.2rem; text-transform: uppercase;">
          {t.titulo} <span class="text-gradient">{t.titulo_gradiente}</span>
        </h3>

        <div class="personal-rows-list" style="margin-bottom: 1.8rem;">
          <div class="modal-data-row">
            <i class="fa-solid fa-map-pin" style="color: var(--neon-yellow); font-size: 1.1rem; width: 1.4rem;"></i>
            <span style="font-size: 0.85rem; font-weight: 600;">{app.base.direccion}</span>
          </div>
          <div class="modal-data-row">
            <i class="fa-solid fa-hotel" style="color: var(--neon-yellow); font-size: 1.1rem; width: 1.4rem;"></i>
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--neon-yellow);">{negocioT.base_referencia}</span>
          </div>
          <div class="modal-data-row">
            <i class="fa-brands fa-whatsapp" style="color: var(--wa-green); font-size: 1.1rem; width: 1.4rem;"></i>
            <span style="font-size: 0.85rem; font-weight: 700;">{app.telefono}</span>
          </div>
          <div class="modal-data-row">
            <i class="fa-solid fa-clock" style="color: var(--fire-orange); font-size: 1.1rem; width: 1.4rem;"></i>
            <span style="font-size: 0.85rem;">{negocioT.horario}</span>
          </div>
        </div>

        <a href={app.base.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-speed" style="width: 100%; padding: 0.85rem; font-size: 0.85rem;">
          <i class="fa-solid fa-location-arrow"></i>
          <span>{t.btn_maps}</span>
        </a>
      </div>

      <!-- Mapa Embebido / Vista Interactiva -->
      <div class="map-card-container">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3870.287232230198!2d-75.7655102!3d-14.0874593!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9110e3047a0705a7%3A0x6b24508497fa9fb!2sHospedaje%20Hawka!5e0!3m2!1ses!2spe!4v1700000000000!5m2!1ses!2spe"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación Kevin Tours Hospedaje Hawka"
        ></iframe>
      </div>

    </div>
  </div>
</section>
