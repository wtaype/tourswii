---
// src/feature/inicio/seccion/LocationMap.astro
// 📍 Punto de Encuentro Oficial en Google Maps (Gran Formato & 100% Dinámico)
import app from '../../../app.js';
import esJson from '../idioma/es.json';
import enJson from '../idioma/en.json';

interface Props {
  idioma?: 'es' | 'en';
}

const { idioma = 'es' } = Astro.props;
const t = idioma === 'en' ? enJson.ubicacion_seccion : esJson.ubicacion_seccion;
const horario = idioma === 'en' ? app.horarioEn : app.horario;
const baseRef = idioma === 'en' ? app.base.referenciaEn : app.base.referencia;
const cert = idioma === 'en' ? app.certificacionEn : app.certificacion;
---

<section id="ubicacion" class="section-pad">
  <div class="container-wide">
    
    <!-- Encabezado de Sección Centrado -->
    <div class="section-header-center">
      <span class="section-badge-center">
        {t.badge}
      </span>
      <h2 class="section-title-center">
        {t.titulo} <span class="text-gradient">{t.titulo_gradiente}</span>
      </h2>
      <p class="section-desc-center">
        {t.descripcion}
      </p>
    </div>

    <!-- Grid de Ubicación en Gran Formato (Info + Gran Mapa) -->
    <div class="grid-ubicacion-large">
      
      <!-- Ficha de Datos Operativos Base Hawka -->
      <div class="glass-card location-info-card">
        <div class="location-card-header">
          <div class="location-base-badge">
            <i class="fa-solid fa-hotel"></i>
            <span>{app.base.nombre}</span>
          </div>
          <span class="location-status-live">
            <i class="fa-solid fa-circle-dot"></i> ATENCIÓN PRESENCIAL
          </span>
        </div>

        <h3 class="location-card-title">
          Recepción Oficial & Punto de Partida
        </h3>

        <div class="location-details-list">
          <div class="location-detail-item">
            <div class="location-icon-circle" style="color: var(--neon-yellow);">
              <i class="fa-solid fa-location-dot"></i>
            </div>
            <div>
              <span class="location-detail-label">Dirección Exacta</span>
              <strong class="location-detail-value">{app.base.direccion}</strong>
            </div>
          </div>

          <div class="location-detail-item">
            <div class="location-icon-circle" style="color: var(--fire-orange);">
              <i class="fa-solid fa-map-pin"></i>
            </div>
            <div>
              <span class="location-detail-label">Referencia de Encuentro</span>
              <strong class="location-detail-value" style="color: var(--neon-yellow);">{baseRef}</strong>
            </div>
          </div>

          <div class="location-detail-item">
            <div class="location-icon-circle" style="color: var(--glow-cyan);">
              <i class="fa-solid fa-clock"></i>
            </div>
            <div>
              <span class="location-detail-label">Horario de Atención</span>
              <strong class="location-detail-value">{horario}</strong>
            </div>
          </div>

          <div class="location-detail-item">
            <div class="location-icon-circle" style="color: var(--wa-green);">
              <i class="fa-brands fa-whatsapp"></i>
            </div>
            <div>
              <span class="location-detail-label">WhatsApp Directo</span>
              <strong class="location-detail-value">{app.telefono}</strong>
            </div>
          </div>

          <div class="location-detail-item">
            <div class="location-icon-circle" style="color: #a855f7;">
              <i class="fa-solid fa-certificate"></i>
            </div>
            <div>
              <span class="location-detail-label">Garantía y Seguridad</span>
              <strong class="location-detail-value">{cert} · Lockers Gratuitos</strong>
            </div>
          </div>
        </div>

        <a href={app.base.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-speed location-btn-action">
          <i class="fa-solid fa-diamond-turn-right"></i>
          <span>{t.btn_maps}</span>
        </a>
      </div>

      <!-- Gran Mapa Interactivo HD -->
      <div class="map-card-hd glass-card">
        <iframe
          src={app.base.embedUrl}
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación Kevin Tours Hospedaje Hawka Google Maps"
        ></iframe>
      </div>

    </div>
  </div>
</section>
