---
// src/feature/inicio/seccion/HawkaBase.astro
// 📸 Galería de Fotos Reales en Base Hospedaje Hawka (Consume idioma/es.json | en.json)
import esJson from '../idioma/es.json';
import enJson from '../idioma/en.json';

interface Props {
  idioma?: 'es' | 'en';
}

const { idioma = 'es' } = Astro.props;
const t = idioma === 'en' ? enJson.galeria_seccion : esJson.galeria_seccion;
const galeria = idioma === 'en' ? enJson.galeria : esJson.galeria;
---

<section id="galeria" class="section-pad section-bg-subtle">
  <div class="container-wide">
    
    <!-- Encabezado Centrado -->
    <div class="section-header-center">
      <span class="section-badge-center">
        {t.badge}
      </span>
      <h2 class="section-title-center">
        {t.titulo} <span class="text-gradient">{t.titulo_gradiente}</span>
      </h2>
      <p class="section-desc-center">
        {t.descripcion}
      </p>
    </div>

    <!-- Grid de Galería -->
    <div class="gallery-grid">
      {galeria.map(foto => (
        <div class="gallery-card glass-card">
          <img src={foto.src} alt={foto.alt} loading="lazy" />
          <div class="gallery-card-caption">
            <strong class="gallery-caption-title">{foto.titulo}</strong>
            <span class="gallery-caption-sub">{foto.sub}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
