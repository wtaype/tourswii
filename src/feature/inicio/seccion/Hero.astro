---
// src/feature/inicio/seccion/Hero.astro
// 🏁 Hero Banner Principal con 2 Columnas y Animaciones Suaves (Consume idioma/es.json | en.json)
import Calculator from './Calculator.astro';
import app from '../../../app.js';
import esJson from '../idioma/es.json';
import enJson from '../idioma/en.json';

interface Props {
  idioma?: 'es' | 'en';
}

const { idioma = 'es' } = Astro.props;
const t = idioma === 'en' ? enJson.hero : esJson.hero;
---

<section id="inicio" class="section-88vh hero-section-border">
  <div class="container-wide grid-hero">
    
    <!-- Columna Izquierda: Títulos, Acciones y Métricas con Animaciones Suaves -->
    <div>
      <div class="hero-anim-badge hero-badge-tag">
        <i class="fa-solid fa-medal"></i>
        <span>{t.badge}</span>
      </div>

      <h1 class="hero-anim-title hero-main-title">
        {t.titulo1} <span class="text-gradient">{t.titulo_gradiente}</span>
      </h1>

      <p class="hero-anim-desc hero-description">
        {t.descripcion}
      </p>

      <div class="hero-anim-ctas hero-ctas-group">
        <a href={app.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-speed hero-cta-btn">
          <i class="fa-solid fa-person-skiing"></i>
          <span>{t.btn_reservar}</span>
        </a>
        <a href="#tours" class="btn-glass hero-cta-btn">
          <i class="fa-solid fa-compass" style="color: var(--neon-yellow);"></i>
          <span>{t.btn_disciplinas}</span>
        </a>
      </div>

      <!-- 4 Métricas Oficiales -->
      <div class="metrics-grid hero-anim-metrics">
        {t.metricas.map((m, idx) => (
          <div>
            <p class="metric-val" style={idx === 0 ? "color: var(--neon-yellow);" : idx === 1 ? "color: var(--fire-orange);" : idx === 2 ? "color: var(--glow-cyan);" : "color: var(--wa-green);"}>
              {m.valor}
            </p>
            <p class="metric-lbl">{m.label}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Columna Derecha: Cotizador Oficial Flotante con Micro-Animación -->
    <div id="calculadora" class="hero-anim-calc">
      <Calculator idioma={idioma} />
    </div>

  </div>
</section>
