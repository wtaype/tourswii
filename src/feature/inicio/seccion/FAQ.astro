---
// src/feature/inicio/seccion/FAQ.astro
// ❓ Sección 6: Preguntas Frecuentes (Consume idioma/es.json | en.json)
import app from '../../../app.js';
import esJson from '../idioma/es.json';
import enJson from '../idioma/en.json';

interface Props {
  idioma?: 'es' | 'en';
}

const { idioma = 'es' } = Astro.props;
const t = idioma === 'en' ? enJson.faq_seccion : esJson.faq_seccion;
const faqs = idioma === 'en' ? enJson.faqs : esJson.faqs;
---

<section id="faq" class="section-pad section-bg-subtle">
  <div class="container-wide">
    
    <!-- Encabezado Centrado -->
    <div class="section-header-center">
      <span class="section-badge-center">
        {t.badge}
      </span>
      <h2 class="section-title-center">
        {t.titulo} <span class="text-gradient">{t.titulo_gradiente}</span>
      </h2>
      <p class="section-desc-center">
        {t.descripcion}
      </p>
    </div>

    <!-- Grid 2 Columnas: Tarjeta Visual + Acordeón -->
    <div class="faq-layout-grid">
      
      <!-- Col 1: Tarjeta Visual de Soporte Directo -->
      <div class="faq-visual-card glass-card">
        <img src="/tours/sandski_laguna.png" alt="SandSki Huacachina" class="faq-visual-img" loading="lazy" />
        <div class="faq-visual-overlay">
          <span class="faq-visual-tag">
            {t.visual_tag}
          </span>
          <h3 class="faq-visual-title">
            {t.visual_titulo}
          </h3>
          <p class="faq-visual-desc">
            {t.visual_desc}
          </p>
          <a href={app.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-speed faq-visual-btn">
            <i class="fa-brands fa-whatsapp"></i>
            <span>{t.visual_btn}</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Acordeón de FAQs Interactivo -->
      <div class="faq-accordion-list">
        {faqs.map((faq, index) => (
          <details class="glass-card faq-card" open={index === 0}>
            <summary class="faq-question">
              <span>{faq.pregunta}</span>
              <i class="fa-solid fa-chevron-down faq-chevron"></i>
            </summary>
            <p class="faq-answer">
              {faq.respuesta}
            </p>
          </details>
        ))}
      </div>

    </div>

  </div>
</section>
