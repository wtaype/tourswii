---
// src/feature/personal/componentes/PersonalNav.astro
// 📱 Mobile Bottom Navigation 100% Fija (<50 líneas)
---

<nav class="personal-bottom-nav">
  <button type="button" class="staff-bottom-btn active" data-tab="tab_resumen">
    <i class="fa-solid fa-chart-pie"></i>
    <span>Resumen</span>
  </button>
  <button type="button" class="staff-bottom-btn" data-tab="tab_recepcion">
    <i class="fa-solid fa-hotel"></i>
    <span>Recepción</span>
  </button>
  <button type="button" class="staff-bottom-btn" data-tab="tab_salidas">
    <i class="fa-solid fa-car-on"></i>
    <span>Salidas</span>
  </button>
  <button type="button" class="staff-bottom-btn" data-tab="tab_inventario">
    <i class="fa-solid fa-boxes-stacked"></i>
    <span>Inventario</span>
  </button>
  <button type="button" class="staff-bottom-btn" data-tab="tab_tarifas">
    <i class="fa-solid fa-tags"></i>
    <span>Tarifario</span>
  </button>
</nav>

<style>
  .personal-bottom-nav {
    position: fixed;
    bottom: 0;
    inset-inline: 0;
    height: 60px;
    background: var(--header-bg);
    backdrop-filter: blur(16px);
    border-top: 1px solid var(--border-card);
    display: none;
    justify-content: space-around;
    align-items: center;
    z-index: 1000;
    padding: 0 0.5rem;
  }
  .staff-bottom-btn {
    flex: 1;
    height: 100%;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.65rem;
    font-weight: 700;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    cursor: pointer;
    transition: 0.2s;
  }
  .staff-bottom-btn i { font-size: 1.1rem; }
  .staff-bottom-btn.active { color: var(--neon-yellow); }

  @media (max-width: 900px) {
    .personal-bottom-nav { display: flex !important; }
  }
</style>
