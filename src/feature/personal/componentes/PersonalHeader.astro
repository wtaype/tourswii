---
// src/feature/personal/componentes/PersonalHeader.astro
// 🛠️ Barra Superior Fija Sticky para Personal & Recepción Base Hawka (Cero CSS Inline)
import app from '../../../app.js';
---

<header class="header-sticky">
  <div class="container-wide header-wrapper">
    <!-- Logo Staff -->
    <div class="header-logo">
      <div class="header-logo-icon">
        <i class="fa-solid fa-gear"></i>
      </div>
      <div>
        <strong class="header-logo-title">PANEL DE OPERACIONES</strong>
        <span class="header-logo-slogan" style="color: var(--neon-yellow);">
          {app.base.referencia} · Kevin, Anthony & Michael
        </span>
      </div>
    </div>

    <!-- Acciones -->
    <div class="header-actions">
      <button type="button" id="btn_toggle_theme" class="btn-theme-circle" title="Modo Claro / Oscuro">
        <i class="fa-solid fa-moon" id="icon_theme"></i>
      </button>
      <a href="/" class="btn-glass" style="padding: 0.35rem 0.8rem; font-size: 0.72rem;">
        <i class="fa-solid fa-arrow-left"></i> Web Pública
      </a>
    </div>
  </div>
</header>
