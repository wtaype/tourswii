---
// src/feature/personal/seccion/TabSalidas.astro
// 🚙 Pestaña 3: Despacho de Tubulares de Anthony y Michael (Cero CSS Inline)
import { SALIDAS_HOY } from '../data/salidas.data.js';
---

<div class="staff-panel-tab" id="tab_salidas" style="display: none;">
  <div class="personal-table-card">
    <div class="personal-table-header">
      <h3 class="font-heading" style="font-size: 1.15rem; font-weight: 800; color: var(--text-main);">
        Programación de Salidas & Conductores
      </h3>
    </div>

    <div class="personal-rows-list">
      {SALIDAS_HOY.map(salida => (
        <div class="personal-row-item">
          <div>
            <span class="user-badge-tag" style="color: var(--neon-yellow); display: block;">{salida.hora}</span>
            <strong class="user-badge-name">{salida.conductor}</strong>
            <span class="drawer-contact-info" style="text-align: left;">{salida.disciplina}</span>
          </div>

          <div class="topbar-right">
            <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-main);">
              <i class="fa-solid fa-users" style="color: var(--glow-cyan);"></i> {salida.pax} PAX
            </span>
            <span style={`padding: 0.35rem 0.8rem; border-radius: 999px; font-size: 0.72rem; font-weight: 800; background: ${salida.color}22; color: ${salida.color}; border: 1px solid ${salida.color};`}>
              {salida.estado}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
