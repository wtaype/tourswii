---
// src/feature/personal/seccion/TabTarifas.astro
// 🏷️ Pestaña 5: Editor en Vivo de Tarifas PEN / USD (Cero CSS Inline)
import inicioEs from '../../inicio/idioma/es.json';

const disciplinas = inicioEs.disciplinas;
---

<div class="staff-panel-tab" id="tab_tarifas" style="display: none;">
  <div class="personal-table-card">
    <div class="personal-table-header">
      <h3 class="font-heading" style="font-size: 1.15rem; font-weight: 800; color: var(--text-main);">
        Tarifario Oficial & Precios en Vivo
      </h3>
    </div>

    <div class="personal-rows-list">
      {disciplinas.map(d => (
        <div class="personal-row-item">
          <div>
            <strong class="user-badge-name">{d.nombre}</strong>
            <span class="drawer-contact-info" style="text-align: left;">{d.badge} · Equipos y Guía Incluido</span>
          </div>
          <div class="topbar-right">
            <span class="calc-total-amount" style="font-size: 1.1rem;">S/ {d.precio_pen}</span>
            <span class="personal-kpi-val-usd" style="font-size: 0.85rem; font-weight: 700;">${d.precio_usd} USD</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
