---
// src/feature/personal/seccion/TabInventario.astro
// 🎿 Pestaña 4: Control de Stock de Equipos y Botas 35-45 en Base (Cero CSS Inline)
import { INVENTARIO } from '../data/inventario.data.js';
---

<div class="staff-panel-tab" id="tab_inventario" style="display: none;">
  <!-- Equipos Principales -->
  <div class="personal-kpi-grid">
    <div class="personal-kpi-card">
      <span class="personal-kpi-label">Esquís Alpinos</span>
      <strong class="personal-kpi-val personal-kpi-val-pen">{INVENTARIO.esquisAlpinos.disponibles} Disp.</strong>
      <span class="drawer-contact-info" style="text-align: left;">de {INVENTARIO.esquisAlpinos.total} pares</span>
    </div>

    <div class="personal-kpi-card">
      <span class="personal-kpi-label">Tablas Sandboard Pro</span>
      <strong class="personal-kpi-val personal-kpi-val-pax">{INVENTARIO.tablasSandboardPro.disponibles} Disp.</strong>
      <span class="drawer-contact-info" style="text-align: left;">de {INVENTARIO.tablasSandboardPro.total} unidades</span>
    </div>

    <div class="personal-kpi-card">
      <span class="personal-kpi-label">Snowboard Dunas</span>
      <strong class="personal-kpi-val personal-kpi-val-usd">{INVENTARIO.tablasSnowboard.disponibles} Disp.</strong>
      <span class="drawer-contact-info" style="text-align: left;">de {INVENTARIO.tablasSnowboard.total} unidades</span>
    </div>

    <div class="personal-kpi-card">
      <span class="personal-kpi-label">Tablas Bodyboard</span>
      <strong class="personal-kpi-val" style="color: var(--wa-green);">{INVENTARIO.tablasBodyboard.disponibles} Disp.</strong>
      <span class="drawer-contact-info" style="text-align: left;">de {INVENTARIO.tablasBodyboard.total} unidades</span>
    </div>
  </div>

  <!-- Stock de Botas por Talla -->
  <div class="personal-table-card">
    <h4 class="footer-col-title">Disponibilidad de Botas de Nieve (36 - 45)</h4>
    <div class="personal-boot-grid">
      {INVENTARIO.botasNievePorTalla.map(b => (
        <div class="personal-boot-box">
          <strong style="font-size: 1rem; color: var(--neon-yellow); display: block;">#{b.talla}</strong>
          <span style="font-size: 0.72rem; font-weight: 700; color: var(--wa-green);">{b.disponibles} Libres</span>
        </div>
      ))}
    </div>
  </div>
</div>
