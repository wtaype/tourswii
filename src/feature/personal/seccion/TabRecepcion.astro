---
// src/feature/personal/seccion/TabRecepcion.astro
// 🏨 Pestaña 2: Check-in de Turistas, Tallas de Botas y Lockers (Cero CSS Inline)
---

<div class="staff-panel-tab" id="tab_recepcion" style="display: none;">
  <div class="personal-table-card">
    <div class="personal-table-header">
      <h3 class="font-heading" style="font-size: 1.15rem; font-weight: 800; color: var(--text-main);">
        Check-in Rápido en Base Hawka
      </h3>
      <span class="personal-badge-live">EN VIVO</span>
    </div>

    <!-- Pasajeros en Espera de Equipamiento -->
    <div class="personal-rows-list">
      <div class="personal-row-item">
        <div>
          <strong class="user-badge-name">Carlos Mendoza (VIP)</strong>
          <span class="drawer-contact-info" style="text-align: left;">2 Pasajeros · SandSki Pro · Salida 16:00 PM</span>
        </div>
        <div class="topbar-right">
          <span class="personal-chip-boot">
            <i class="fa-solid fa-shoe-prints"></i> Botas: #42 y #38
          </span>
          <span class="personal-chip-locker">
            <i class="fa-solid fa-key"></i> Locker #07
          </span>
          <button type="button" class="btn-speed" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">
            Listo
          </button>
        </div>
      </div>

      <div class="personal-row-item">
        <div>
          <strong class="user-badge-name">Emma Watson (UK)</strong>
          <span class="drawer-contact-info" style="text-align: left;">1 Pasajero · Sandboard Pro · Salida 16:00 PM</span>
        </div>
        <div class="topbar-right">
          <span class="personal-chip-boot">
            <i class="fa-solid fa-shoe-prints"></i> Botas: #37
          </span>
          <span class="personal-chip-locker">
            <i class="fa-solid fa-key"></i> Locker #12
          </span>
          <button type="button" class="btn-speed" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">
            Listo
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
