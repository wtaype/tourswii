---
// src/feature/personal/seccion/TabResumen.astro
// 📊 Pestaña 1: Resumen de Caja y Métricas Operativas (Cero CSS Inline)
import { CAJA_HOY } from '../data/caja.data.js';
---

<div class="staff-panel-tab active" id="tab_resumen">
  <!-- KPIs Rápidos -->
  <div class="personal-kpi-grid">
    <div class="personal-kpi-card">
      <span class="personal-kpi-label">Total Recaudado (PEN)</span>
      <strong class="personal-kpi-val personal-kpi-val-pen">S/ {CAJA_HOY.ingresosTotalesPen}</strong>
      <span class="personal-kpi-sub">+ S/ 540 vs ayer</span>
    </div>

    <div class="personal-kpi-card">
      <span class="personal-kpi-label">Total Dólares (USD)</span>
      <strong class="personal-kpi-val personal-kpi-val-usd">${CAJA_HOY.ingresosTotalesUsd}</strong>
      <span class="personal-kpi-muted">Turistas Extranjeros</span>
    </div>

    <div class="personal-kpi-card">
      <span class="personal-kpi-label">Pasajeros Atendidos</span>
      <strong class="personal-kpi-val personal-kpi-val-pax">{CAJA_HOY.pasajerosAtendidos}</strong>
      <span class="personal-kpi-muted">{CAJA_HOY.salidasDespachadas} Salidas en Tubular</span>
    </div>
  </div>

  <!-- Desglose por Método de Pago -->
  <div class="personal-table-card">
    <h4 class="footer-col-title">Cobros Registrados por Canal</h4>
    <div class="personal-rows-list">
      {CAJA_HOY.metodosPago.map(p => (
        <div class="personal-row-item">
          <div class="topbar-left">
            <i class={`fa-solid ${p.icono}`} style={`color: ${p.color}; font-size: 1.1rem; width: 1.4rem;`}></i>
            <span style="font-weight: 700; color: var(--text-main);">{p.metodo}</span>
          </div>
          <strong style="color: var(--neon-yellow);">S/ {p.montoPen}</strong>
        </div>
      ))}
    </div>
  </div>
</div>
