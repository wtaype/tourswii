---
// src/core/layouts/Principal.astro
// 🌟 Layout Maestro Unificado Ultra-Liviano (0 Peticiones HTTP Bloqueantes - Workwii Style)
import { ClientRouter } from 'astro:transitions';
import Topbar from '../componentes/Topbar.astro';
import Header from '../componentes/Header.astro';
import DrawerMobile from '../componentes/DrawerMobile.astro';
import Footer from '../componentes/Footer.astro';
import WhatsAppFloat from '../../feature/inicio/componentes/WhatsAppFloat.astro';
import UserModal from '../../feature/auth/componentes/UserModal.astro';

import { getMeta, getJsonLd } from '../seo.js';
import { USUARIO_VIP } from '../../feature/auth/data/usuario.data.js';

import estilosTema from '../wicss/witema.css?raw';
import appCss from '../wicss/app.css?raw';
import inicioCss from '../../feature/inicio/inicio.css?raw';
import authCss from '../../feature/auth/auth.css?raw';
import googleCss from '../../../public/google/fonts.css?raw';
import awesomeCss from '../../../public/fontawesome/css/all.min.css?raw';

const globalCss = estilosTema + '\n' + appCss + '\n' + inicioCss + '\n' + authCss + '\n' + googleCss + '\n' + awesomeCss;

interface Props {
  idioma?: 'es' | 'en';
  esVip?: boolean;
  ruta?: string;
}

const { idioma = 'es', esVip = false, ruta = '/' } = Astro.props;
const meta = getMeta(ruta);
const jsonLd = getJsonLd(ruta);
---

<!DOCTYPE html>
<html lang={idioma} data-theme="futuro" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <title>{meta.title}</title>
  <meta name="description" content={meta.description} />
  <link rel="canonical" href={meta.canonical} />
  
  <!-- OpenGraph & Twitter -->
  <meta property="og:title" content={meta.title} />
  <meta property="og:description" content={meta.description} />
  <meta property="og:image" content={meta.image} />
  <meta property="og:url" content={meta.canonical} />
  
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- ClientRouter para navegación instantánea SPA -->
  <ClientRouter />

  <!-- Estilos Inlined Globales Unificados (0 Peticiones HTTP Externas) -->
  <style is:global data-astro-transition-persist="global-css" set:html={globalCss}></style>

  <!-- Anti-FOUC & Gestor Ligero de Tema (0 dependencias) -->
  <script is:inline>
    function applyWiTema() {
      try {
        const saved = localStorage.getItem('wiTema');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'futuro' : 'luz';
        const theme = (saved === 'luz' || saved === 'futuro') ? saved : system;
        document.documentElement.dataset.theme = theme;
        const icon = document.getElementById('icon_theme');
        if (icon) icon.className = theme === 'futuro' ? 'fa-solid fa-moon' : 'fa-solid fa-sun';
      } catch (e) {}
    }

    function toggleWiTema() {
      const current = document.documentElement.dataset.theme === 'luz' ? 'luz' : 'futuro';
      const next = current === 'futuro' ? 'luz' : 'futuro';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('wiTema', next); } catch (e) {}
      const icon = document.getElementById('icon_theme');
      if (icon) icon.className = next === 'futuro' ? 'fa-solid fa-moon' : 'fa-solid fa-sun';
    }

    applyWiTema();
    document.addEventListener('astro:after-swap', applyWiTema);
    document.addEventListener('DOMContentLoaded', applyWiTema);
  </script>
</head>

<body>
  <!-- Topbar Oficial -->
  <Topbar idioma={idioma} />

  <!-- Cabecera Sticky Responsive Bilingüe -->
  <Header
    idioma={idioma}
    esVip={esVip}
    usuarioNombre={USUARIO_VIP.nombre}
    usuarioAvatar={USUARIO_VIP.avatar}
  />

  <!-- Menú Drawer Móvil -->
  <DrawerMobile
    idioma={idioma}
    esVip={esVip}
    usuarioNombre={USUARIO_VIP.nombre}
    usuarioTalla={USUARIO_VIP.tallaBota}
  />

  <!-- Contenido Dinámico de la Página -->
  <main id="main_content">
    <slot />
  </main>

  <!-- Pie de Página Centrado y Oficial -->
  <Footer idioma={idioma} />

  <!-- Botón Flotante Oficial de WhatsApp -->
  <WhatsAppFloat />

  <!-- Modal Universal de Usuario / VIP -->
  <UserModal idioma={idioma} />

  <!-- Manejador Ligero de Drawer Móvil -->
  <script>
    function initDrawer() {
      const btnOpen = document.getElementById('btn_open_drawer');
      const btnClose = document.getElementById('btn_close_drawer');
      const backdrop = document.getElementById('drawer_backdrop');
      const drawer = document.getElementById('mobile_drawer');

      const toggleDrawer = (open: boolean) => {
        if (!drawer || !backdrop) return;
        drawer.classList.toggle('open', open);
        backdrop.classList.toggle('open', open);
        document.body.style.overflow = open ? 'hidden' : '';
      };

      if (btnOpen) btnOpen.onclick = () => toggleDrawer(true);
      if (btnClose) btnClose.onclick = () => toggleDrawer(false);
      if (backdrop) backdrop.onclick = () => toggleDrawer(false);

      document.querySelectorAll('.drawer-item').forEach(link => {
        link.addEventListener('click', () => toggleDrawer(false));
      });
    }

    document.addEventListener('DOMContentLoaded', initDrawer);
    document.addEventListener('astro:page-load', initDrawer);
  </script>
</body>
</html>
