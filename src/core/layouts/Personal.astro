---
// src/core/layouts/Personal.astro
// 🛠️ Layout del Panel del Dueño & Staff Kevin Tours (0 Peticiones HTTP Bloqueantes)
import { ClientRouter } from 'astro:transitions';
import estilosTema from '../wicss/witema.css?raw';
import appCss from '../wicss/app.css?raw';
import personalCss from '../../feature/personal/personal.css?raw';
import googleCss from '../../../public/google/fonts.css?raw';
import awesomeCss from '../../../public/fontawesome/css/all.min.css?raw';

const globalCss = estilosTema + '\n' + appCss + '\n' + personalCss + '\n' + googleCss + '\n' + awesomeCss;

interface Props {
  idioma?: 'es' | 'en';
  titulo?: string;
}

const { idioma = 'es', titulo = 'Panel de Operaciones | Kevin Tours' } = Astro.props;
---

<!DOCTYPE html>
<html lang={idioma} data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <title>{titulo}</title>

  <!-- ClientRouter -->
  <ClientRouter />

  <!-- Estilos Inlined Globales Unificados -->
  <style is:global data-astro-transition-persist="personal-css" set:html={globalCss}></style>

  <!-- Anti-FOUC Inmediato -->
  <script is:inline>
    function applyWiTema() {
      try {
        const saved = localStorage.getItem('wiTema');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'futuro' : 'luz';
        const theme = (saved === 'luz' || saved === 'futuro') ? saved : system;
        document.documentElement.dataset.theme = theme;
      } catch (e) {}
    }
    applyWiTema();
    document.addEventListener('astro:after-swap', applyWiTema);
    document.addEventListener('DOMContentLoaded', applyWiTema);
  </script>
</head>

<body>
  <div class="personal-layout-container">
    <slot />
  </div>
</body>
</html>
