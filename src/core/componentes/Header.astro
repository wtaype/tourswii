---
// src/core/componentes/Header.astro
// 🌟 Cabecera Responsive y Dinámica 100% desde app.js (Cero Solapamientos)
import app from '../../app.js';
import esJson from '../idioma/es.json';
import enJson from '../idioma/en.json';

interface Props {
  idioma?: 'es' | 'en';
  esVip?: boolean;
  usuarioNombre?: string;
  usuarioAvatar?: string;
}

const {
  idioma = 'es',
  esVip = false,
  usuarioNombre = 'Carlos Mendoza',
  usuarioAvatar = 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=120&q=80'
} = Astro.props;

const t = idioma === 'en' ? enJson.nav : esJson.nav;
const slogan = idioma === 'en' ? app.sloganEn : app.slogan;

// Separar dinámicamente el nombre de la app (ej: 'Kevin Tours Evolution' -> 'KEVIN TOURS' + 'EVOLUTION')
const titleWords = (app.app || 'Kevin Tours Evolution').split(' ');
const mainTitle = titleWords.length > 1 ? titleWords.slice(0, -1).join(' ') : titleWords[0];
const accentTitle = titleWords.length > 1 ? titleWords[titleWords.length - 1] : '';
---

<header class="header-sticky">
  <div class="container-wide header-wrapper">
    <!-- Logo 100% Dinámico desde app.js -->
    <a href={idioma === 'en' ? '/en' : '/'} class="header-logo">
      <div class="header-logo-icon">
        <i class="fa-solid fa-person-skiing"></i>
      </div>
      <div class="header-logo-text">
        <span class="header-logo-title">
          {mainTitle} {accentTitle && <span class="text-gradient">{accentTitle}</span>}
        </span>
        <span class="header-logo-slogan" id="txt_logo_sub">
          {slogan}
        </span>
      </div>
    </a>

    <!-- Menú Desktop -->
    <nav class="nav-desktop-container">
      <a href="#inicio" class="nav-link-item">{t.inicio}</a>
      <a href="#tours" class="nav-link-item">{t.disciplinas}</a>
      <a href="#galeria" class="nav-link-item">{t.galeria}</a>
      <a href="#ubicacion" class="nav-link-item">{t.ubicacion}</a>
      <a href="#confianza" class="nav-link-item">{t.confianza}</a>
      <a href="#faq" class="nav-link-item">{t.faq}</a>
    </nav>

    <!-- Zona Derecha: Idioma + Tema + Acción/VIP + Hamburguesa -->
    <div class="header-actions">
      <div class="pill-lang-box">
        <a href="/" class={`pill-lang-btn ${idioma === 'es' ? 'active' : ''}`} id="btn_lang_es">ES</a>
        <a href="/en" class={`pill-lang-btn ${idioma === 'en' ? 'active' : ''}`} id="btn_lang_en">EN</a>
      </div>

      <button type="button" id="btn_toggle_theme" class="btn-theme-circle" title="Modo Claro / Oscuro">
        <i class="fa-solid fa-moon" id="icon_theme"></i>
      </button>

      {esVip ? (
        <button type="button" id="btn_abrir_perfil_modal" class="user-badge-btn" title="Mi Cuenta VIP">
          <img src={usuarioAvatar} alt={usuarioNombre} class="user-avatar-img" />
          <div class="hide-mobile">
            <strong class="user-badge-name">{usuarioNombre}</strong>
            <span class="user-badge-tag">{t.perfil_vip} <i class="fa-solid fa-chevron-down"></i></span>
          </div>
        </button>
      ) : (
        <div class="header-desktop-actions">
          <a href="/cliente" class="btn-ingresar-link">
            <i class="fa-solid fa-arrow-right-to-bracket"></i> {t.ingresar}
          </a>
          <a href="#cotizador" class="btn-reservar-header">
            <i class="fa-solid fa-calendar-check"></i> {t.reservar}
          </a>
        </div>
      )}

      <button type="button" id="btn_open_drawer" class="btn-hamburger" aria-label="Abrir menú">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </div>
</header>
