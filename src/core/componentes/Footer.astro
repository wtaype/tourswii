---
// src/core/componentes/Footer.astro
// 🦶 Pie de Página Centrado en Móvil y Responsive (<75 líneas)
import { NEGOCIO } from '../config/constantes.js';

interface Props {
  idioma?: 'es' | 'en';
}

const { idioma = 'es' } = Astro.props;
---

<footer style="background: var(--bg-body); border-top: 1px solid var(--border-card); padding: 5vh 0 4vh 0; font-size: 0.85rem; color: var(--text-muted);">
  <div class="container-wide">
    <div class="grid-footer" style="display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 2.5rem; margin-bottom: 3.5vh;">
      
      <!-- Col 1: Marca y Redes -->
      <div class="footer-brand-center">
        <div style="display: inline-flex; align-items: center; gap: 0.7rem; margin-bottom: 0.8rem;">
          <div style="width: 2.2rem; height: 2.2rem; border-radius: 0.6rem; background: linear-gradient(135deg, #ffe600, #ff4500); display: flex; align-items: center; justify-content: center; color: #000; font-size: 1rem; font-weight: 900;">
            <i class="fa-solid fa-person-skiing"></i>
          </div>
          <strong style="color: var(--text-main); font-size: 1.1rem;">{NEGOCIO.nombre}</strong>
        </div>
        <p style="font-size: 0.8rem; line-height: 1.6; margin-bottom: 1.2rem; max-width: 320px;">
          {idioma === 'en' ? 'Official SandSki and Pro Sandboard School at the Huacachina Desert Oasis, Ica. Base at Hospedaje Hawka.' : 'Escuela oficial de SandSki y Sandboard Profesional en el Oasis de Huacachina, Ica. Base física en Hospedaje Hawka.'}
        </p>
        <div class="footer-social-center" style="display: flex; gap: 0.6rem;">
          <a href={NEGOCIO.redes.facebook} target="_blank" rel="noopener noreferrer" style="width: 2.2rem; height: 2.2rem; border-radius: 50%; background: #1877F2; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; text-decoration: none;"><i class="fa-brands fa-facebook-f"></i></a>
          <a href={NEGOCIO.redes.instagram} target="_blank" rel="noopener noreferrer" style="width: 2.2rem; height: 2.2rem; border-radius: 50%; background: linear-gradient(45deg,#f58529,#dd2a7b,#515bd4); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; text-decoration: none;"><i class="fa-brands fa-instagram"></i></a>
          <a href={NEGOCIO.redes.tiktok} target="_blank" rel="noopener noreferrer" style="width: 2.2rem; height: 2.2rem; border-radius: 50%; background: #000; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; border: 1px solid rgba(255,255,255,0.2); text-decoration: none;"><i class="fa-brands fa-tiktok"></i></a>
          <a href={NEGOCIO.redes.whatsapp} target="_blank" rel="noopener noreferrer" style="width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--wa-green); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; text-decoration: none;"><i class="fa-brands fa-whatsapp"></i></a>
        </div>
      </div>

      <!-- Col 2: Disciplinas -->
      <div>
        <h4 style="color: var(--text-main); font-size: 0.9rem; font-weight: 800; text-transform: uppercase; margin-bottom: 0.9rem;">{idioma === 'en' ? '4 Disciplines' : '4 Disciplinas'}</h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.8rem; padding: 0;">
          <li><a href="#tours" style="color: var(--text-muted); text-decoration: none;">SandSki Profesional</a></li>
          <li><a href="#tours" style="color: var(--text-muted); text-decoration: none;">Sandboard Pro con Botas</a></li>
          <li><a href="#tours" style="color: var(--text-muted); text-decoration: none;">Snowboard Pro en Dunas</a></li>
          <li><a href="#tours" style="color: var(--text-muted); text-decoration: none;">Bodyboard en Arena</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal -->
      <div>
        <h4 style="color: var(--text-main); font-size: 0.9rem; font-weight: 800; text-transform: uppercase; margin-bottom: 0.9rem;">{idioma === 'en' ? 'Legal & Trust' : 'Legal & Base'}</h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.8rem; padding: 0;">
          <li><a href="#faq" style="color: var(--text-muted); text-decoration: none;">Acerca de Kevin Tours</a></li>
          <li><a href="#faq" style="color: var(--text-muted); text-decoration: none;">Seguro SOAT Turístico</a></li>
          <li><a href="#faq" style="color: var(--text-muted); text-decoration: none;">Términos y Condiciones</a></li>
          <li><a href="#faq" style="color: var(--text-muted); text-decoration: none;">Libro de Reclamaciones</a></li>
        </ul>
      </div>

      <!-- Col 4: Base Hawka -->
      <div>
        <h4 style="color: var(--text-main); font-size: 0.9rem; font-weight: 800; text-transform: uppercase; margin-bottom: 0.9rem;">Base Hawka</h4>
        <p style="font-size: 0.8rem; margin-bottom: 0.4rem;"><i class="fa-solid fa-location-dot" style="color: var(--neon-yellow); margin-right: 0.4rem;"></i> {NEGOCIO.ubicacion.direccion}</p>
        <p style="font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--neon-yellow); font-weight: 700;"><i class="fa-solid fa-hotel" style="margin-right: 0.4rem;"></i> {NEGOCIO.ubicacion.referencia}</p>
        <p style="font-size: 0.8rem;"><i class="fa-solid fa-clock" style="color: var(--fire-orange); margin-right: 0.4rem;"></i> {NEGOCIO.ubicacion.horario}</p>
      </div>

    </div>

    <!-- Barra Inferior -->
    <div style="border-top: 1px solid var(--border-card); padding-top: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; font-size: 0.76rem;" class="footer-bottom-bar">
      <span>{NEGOCIO.certificacion}</span>
      <span>© 2026 {NEGOCIO.nombre}. Todos los derechos reservados.</span>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 900px) {
    .grid-footer { grid-template-columns: 1fr !important; text-align: center !important; gap: 2rem !important; }
    .footer-brand-center, .footer-social-center { display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: center !important; }
    .footer-social-center { flex-direction: row !important; }
    .footer-bottom-bar { flex-direction: column !important; text-align: center !important; }
  }
</style>
