---
// src/core/componentes/DrawerMobile.astro
// 📱 Menú Lateral Móvil Off-Canvas con Backdrop Blur (Consume core/idioma/)
import app from '../../app.js';
import esJson from '../idioma/es.json';
import enJson from '../idioma/en.json';

interface Props {
  idioma?: 'es' | 'en';
  esVip?: boolean;
  usuarioNombre?: string;
  usuarioTalla?: string;
}

const {
  idioma = 'es',
  esVip = false,
  usuarioNombre = 'Carlos Mendoza',
  usuarioTalla = '42'
} = Astro.props;

const t = idioma === 'en' ? enJson.nav : esJson.nav;
const commonT = idioma === 'en' ? enJson.comun : esJson.comun;
---

<div class="mobile-drawer-backdrop" id="drawer_backdrop"></div>

<aside class="mobile-drawer" id="mobile_drawer">
  <div class="drawer-header">
    <div class="header-logo">
      <div class="header-logo-icon">
        <i class="fa-solid fa-person-skiing"></i>
      </div>
      <div>
        <strong class="header-logo-title">KEVIN TOURS</strong>
        <span class="header-logo-slogan">{app.slogan}</span>
      </div>
    </div>
    <button type="button" class="drawer-close-btn" id="btn_close_drawer" aria-label="Cerrar menú">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  {esVip && (
    <div class="drawer-user-card">
      <div class="topbar-left">
        <i class="fa-solid fa-user-shield" style="color: var(--neon-yellow);"></i>
        <div>
          <strong class="user-badge-name">{usuarioNombre}</strong>
          <span class="user-badge-tag">{t.perfil_vip} · BOTA #{usuarioTalla}</span>
        </div>
      </div>
    </div>
  )}

  <nav class="drawer-nav">
    <a href="#inicio" class="drawer-item">
      <i class="fa-solid fa-chevron-right drawer-item-arrow"></i>
      <span>{t.inicio}</span>
    </a>
    <a href="#tours" class="drawer-item">
      <i class="fa-solid fa-chevron-right drawer-item-arrow"></i>
      <span>{t.disciplinas}</span>
    </a>
    <a href="#galeria" class="drawer-item">
      <i class="fa-solid fa-chevron-right drawer-item-arrow"></i>
      <span>{t.galeria}</span>
    </a>
    <a href="#ubicacion" class="drawer-item">
      <i class="fa-solid fa-chevron-right drawer-item-arrow"></i>
      <span>{t.ubicacion}</span>
    </a>
    <a href="#confianza" class="drawer-item">
      <i class="fa-solid fa-chevron-right drawer-item-arrow"></i>
      <span>{t.confianza}</span>
    </a>
    <a href="#faq" class="drawer-item">
      <i class="fa-solid fa-chevron-right drawer-item-arrow"></i>
      <span>{t.faq}</span>
    </a>
    <a href="/cliente" class="drawer-item" style="color: var(--glow-cyan);">
      <i class="fa-solid fa-user-astronaut"></i>
      <span>{t.perfil_vip}</span>
    </a>
    <a href="/personal" class="drawer-item" style="color: var(--neon-yellow);">
      <i class="fa-solid fa-gauge-high"></i>
      <span>{t.panel_staff}</span>
    </a>
  </nav>

  <div class="drawer-footer">
    <a href={app.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-speed drawer-wa-btn">
      <i class="fa-brands fa-whatsapp"></i>
      <span>{commonT.whatsapp_btn}</span>
    </a>
    <p class="drawer-contact-info">
      <i class="fa-solid fa-location-dot"></i> {app.base.referencia}
    </p>
  </div>
</aside>

<style>
  .mobile-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .mobile-drawer-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: -320px;
    width: 300px;
    height: 100vh;
    background: var(--bg-card);
    border-left: 1px solid var(--border-card);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem;
    box-shadow: var(--shadow-xl);
    transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-drawer.open {
    right: 0;
  }
  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--border-card);
  }
  .drawer-close-btn {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--bg-subtle);
    border: 1px solid var(--border-card);
    color: var(--text-main);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .drawer-user-card {
    margin: 1rem 0;
    padding: 0.8rem;
    background: var(--bg-subtle);
    border-radius: 0.8rem;
    border: 1px solid var(--border-card);
  }
  .drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 1.5rem 0;
    flex: 1;
  }
  .drawer-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem;
    border-radius: 0.7rem;
    color: var(--text-main);
    font-weight: 700;
    font-size: 0.9rem;
    transition: 0.2s;
  }
  .drawer-item:hover {
    background: var(--bg-subtle);
    color: var(--neon-yellow);
  }
  .drawer-item-arrow {
    font-size: 0.7rem;
    color: var(--neon-yellow);
  }
  .drawer-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--border-card);
  }
  .drawer-wa-btn {
    width: 100%;
    padding: 0.8rem;
    font-size: 0.85rem;
  }
  .drawer-contact-info {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 0.8rem;
  }
</style>
