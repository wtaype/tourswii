---
// src/core/componentes/Sidebar.astro
// 🛠️ Barra Lateral Desktop para el Layout Personal.astro (<45 líneas)
---

<aside class="personal-sidebar">
  <span class="personal-sidebar-title">Operaciones Hawka</span>
  <button type="button" class="personal-nav-item active" data-tab="tab_resumen">
    <i class="fa-solid fa-chart-pie"></i>
    <span>Resumen de Caja</span>
  </button>
  <button type="button" class="personal-nav-item" data-tab="tab_recepcion">
    <i class="fa-solid fa-hotel"></i>
    <span>Recepción Base</span>
  </button>
  <button type="button" class="personal-nav-item" data-tab="tab_salidas">
    <i class="fa-solid fa-car-on"></i>
    <span>Despacho Salidas</span>
  </button>
  <button type="button" class="personal-nav-item" data-tab="tab_inventario">
    <i class="fa-solid fa-boxes-stacked"></i>
    <span>Stock de Botas</span>
  </button>
  <button type="button" class="personal-nav-item" data-tab="tab_tarifas">
    <i class="fa-solid fa-tags"></i>
    <span>Tarifario en Vivo</span>
  </button>
</aside>
